#
# lastread — image a failing disk with GNU ddrescue without killing it, and recover files from
# the image. The failing disk is only ever read.
#
# What it adds on top of plain ddrescue:
#   * phases picked from the ddrescue map, so any stop (overheating, Ctrl+C, the disk dropping off
#     the bus, a reboot) is followed by a plain re-run that continues where it stopped;
#   * a watchdog: temperature (smartctl) and the device itself are checked every --interval seconds;
#   * "deferred zones": places where the disk hangs are set aside and read last, from both ends;
#   * a dropped disk is detected, ddrescue is stopped before it marks the rest as bad, and the disk
#     is brought back by rescanning its SCSI host when the transport allows it;
#   * a file level (NTFS, The Sleuth Kit, no mounting): which files are intact, which are damaged,
#     targeted recovery of chosen files, extraction of intact files, detection of silent garbage.
# See README.md and docs/how-it-works.md; `lastread --help` lists every option.
set -Eeuo pipefail
# One locale for all parsing (tool output, number formats, sort order, binary grep).
export LC_ALL=C

VERSION=0.1.0
PROG=lastread

# --- Defaults (every one can be changed by an option) --------------------------------------------

source_arg="" name="" dir=.
stop=48 resume=44 interval=60
min_rate="" skip_size="" retries=3 reverse=0 start_at="" add_zones=() give_up=0
rescan=1 rescan_pause=60 rescan_attempts=3 kernel_timeout=180
zone_margin=$((1000 * 1000 * 1000))     # a hang defers this much on each side of the hang position
zone_min_progress=$((16 * 1024 * 1024)) # an attempt narrowing a zone by less is a failure; two in a row = core
artifact_limit=$((1000 * 1000 * 1000))  # more "dropped disk" traces than this are reverted
artifact_bad=$((16 * 1024 * 1024))      # a "bad" area larger than this in one piece is a trace, not a bad spot
temp_cmd=${LASTREAD_TEMP_CMD:-} smart_type="" no_temp=0
partition=""
meta_first=1 firsts=()          # read the structures of the volume (and --first paths) before the rest
recheck_garbage=0 GARBAGE_RE=""
verify=0 overwrite=0 extract=0 extract_damaged=0 inventory=0 pick=0 file_patterns=() no_fs=0
extract_to="" includes=() maps=() owner="" file_mode=0664 dir_mode=0775
suspect_patterns=() suspect_zeros=$((128 * 1024)) suspect_check=1
DRY_RUN=0
accept_source_change=0               # explicitly adopt a changed source identity
readonly_flag=1                       # set the kernel read-only flag on the source while rescuing
event_cmd=${LASTREAD_ON_EVENT:-}      # program run on events (--on-event)
print_service=0                       # print a systemd unit for the command line and exit
status=0 json=0                       # --status [--json]
triage=0 triage_timeout=20            # --triage

# Observed on a real failing 2.5" SMR drive: service sectors with the tag "sEDU" at the start and
# at the end of a 512-byte sector were returned instead of data, with no read error.
DEFAULT_SUSPECT_RE='sEDU\x00{504}sEDU'

# --- State ---------------------------------------------------------------------------------------

SECTOR=512 PART_SIZE=0 CLUSTER=0
FS_KIND="" FS_OFFSET=0 TSK_O=() FSOUT="" # file system family (ntfs ext fat), where the volume starts in the image (bytes), the TSK -o option, fsstat-style description
dev="" parent="" whole="" SCSI_HOST="" TRANSPORT="" timeout_file=""
img="" map="" logs="" zones="" domain="" LOG="" RATES=""
TMPD="" DD_PID="" INHIBIT_PID="" orig_timeout=""
TEMP_GUARD=1 SMART_ARGS=()
RO_SET=0 RO_ORIG="" # the read-only flag: did we set it, what was it before
RUN_STARTED=0 RUN_STATE="" CUR_PHASE="" LAST_TEMP="" RESCUED="" RATE=""
RATE_T=() RATE_B=()
TRI_NOTES=() TRI_WARN=() TRI_RED=() TRI_RES="" TRI_MS=0 SMART_TYPE_FOUND=""
ORIG_ARGS=()
TARGET_RANGES="" PRIORITY_MODE=0 # PRIORITY_MODE: the ranges in TARGET_RANGES are read without the deferred zones
# Set by image_prepare: ok | skipped (no file level for this image) | missing (no Sleuth Kit)
FS_STATE=""
RUN_AS=() SUSPECT_RE="" STREAM_SHA="" MANIFEST=""
recoveries=0
ZS="" ZE="" ZD=""
C_RED="" C_YELLOW="" C_BOLD="" C_RESET=""

# --- Messages ------------------------------------------------------------------------------------

log() { printf '%s\n' "$*"; }
info() { printf '%s %s%s%s\n' "$(date '+%H:%M:%S')" "$C_BOLD" "$*" "$C_RESET"; }
warn() { printf '%s %swarning:%s %s\n' "$(date '+%H:%M:%S')" "$C_YELLOW" "$C_RESET" "$*" >&2; }
die() { die_code 1 "$@"; }
# die_code CODE MESSAGE: exit codes are 1 error, 3 power cycle needed (see --help).
die_code() {
  local code=$1
  shift
  printf '%s %serror:%s %s\n' "$(date '+%H:%M:%S')" "$C_RED" "$C_RESET" "$*" >&2
  if ((RUN_STARTED)); then
    if [[ $code == 3 ]]; then write_state power-cycle; else
      write_state failed
      notify failed "$*"
    fi
  fi
  exit "$code"
}
# notify EVENT MESSAGE: runs --on-event PROGRAM in the background (never blocks the rescue, its
# failure is ignored). No shell is involved: the program gets the event and the message as
# arguments and LASTREAD_EVENT, LASTREAD_MESSAGE, LASTREAD_NAME, LASTREAD_DIR, LASTREAD_STATUS.
notify() {
  [[ -n $event_cmd ]] || return 0
  local st
  st="$(status_short 2>/dev/null)" || st=""
  LASTREAD_EVENT=$1 LASTREAD_MESSAGE=$2 LASTREAD_NAME=$name LASTREAD_DIR=$dir LASTREAD_STATUS=$st \
    timeout 60 "$event_cmd" "$1" "$2" </dev/null >>"${LOG:-/dev/null}" 2>&1 8>&- &
}
# write_state STATE: the small state file that --status reads (atomically replaced).
write_state() {
  RUN_STATE=$1
  [[ -n $logs && -d $logs ]] || return 0
  if printf 'updated=%s\npid=%s\nstate=%s\nphase=%s\ntemperature=%s\nrescued=%s\nrate=%s\nmeta=%s\n' \
    "$(date +%s)" "$$" "$1" "$CUR_PHASE" "$LAST_TEMP" "$RESCUED" "$RATE" "$((meta_first && !no_fs))" >"$logs/state.new" 2>/dev/null; then
    mv -f "$logs/state.new" "$logs/state" 2>/dev/null || true
  fi
}
# Message to the screen and to the run log (once the log directory exists).
note() {
  info "$*"
  [[ -z $logs || ! -d $logs ]] || printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"
}
on_err() {
  printf '%s %serror:%s command "%s" failed with exit code %s (line %s)\n' \
    "$(date '+%H:%M:%S')" "$C_RED" "$C_RESET" "$2" "$1" "$3" >&2
}

usage() {
  cat <<EOF
Usage: sudo $PROG SOURCE [options]
       sudo $PROG --inventory [--name NAME] [options]

Images the disk or partition SOURCE with GNU ddrescue while watching its temperature and its
presence on the bus, finds the files touched by unreadable areas and (optionally) extracts the
intact ones. Re-running the same command continues where the previous run stopped.

SOURCE is a block device. Prefer a stable name such as /dev/disk/by-id/ata-...-part1: the name
sdX can change when a dropped disk is brought back. SOURCE is only read.

Files and layout:
  --dir DIR            directory for NAME.img, NAME.map and NAME.logs/ [current directory];
                       must exist and must not be on the failing disk
  --name NAME          base name of the image files [base name of SOURCE]
  --accept-source-change  adopt a changed source identity after checking it is the same disk

Watchdog:
  --stop C             stop ddrescue at this temperature, °C [48]
  --resume C           continue at this temperature or lower, °C [44]
  --interval SEC       how often to check temperature and the device [60]
  --temp-cmd PROGRAM   read the temperature from PROGRAM instead of smartctl: it is run with the
                       whole-disk device as its only argument and prints °C (no shell involved;
                       default from \$LASTREAD_TEMP_CMD). Useful for tests and odd sensors.
  --smart-type TYPE    smartctl -d TYPE (for example sat for a SATA disk behind a USB bridge);
                       by default plain smartctl is tried first, then -d sat
  --no-temp            do not watch the temperature at all
                       (without any working temperature source the tool warns and runs unwatched)

Reading (copy phase):
  --min-rate RATE      defer places that read slower than this (ddrescue -a), for example 20M
  --skip-size SIZE     first jump after an error or slow read, doubling afterwards (ddrescue -K),
                       for example 1Mi or 1Mi,1Gi with a ceiling [64Ki]
  --retries N          passes over unreadable sectors in the retry phase [3]
  --reverse            read the copy phase from the end of the device to the start
  --start-at POS       start the first copy run here, for example 1700G (k/M/G/T are powers of
                       1000, Ki/Mi/Gi/Ti powers of 1024); what was skipped is read in later passes

Deferred zones (places where the disk hangs):
  --add-zone FROM-TO   defer a zone by hand, for example 511G-521G; added once: later runs do not
                       add the same zone again (it would widen a zone that has been narrowed)
  --give-up-zones      give up the deferred zones that the disk does not read: files inside are
                       reported as damaged
  --zone-margin SIZE   a hang defers this much on each side of the hang position [1G]
  --zone-min-progress SIZE
                       an attempt that narrows a zone by less than this failed; two failures in a
                       row make the zone a core the disk does not read [16Mi]

Dropped disk:
  --rescan-pause SEC   pause before rescanning the SCSI host of a dropped disk [60]
  --rescan-attempts N  returns in a row without progress before asking for a power cycle [3]
  --no-rescan          do not bring the disk back by rescanning; ask for a power cycle at once
  --kernel-timeout SEC command timeout of the kernel for the disk while rescuing, restored on exit;
                       0 leaves it alone [180]
  --artifact-limit SIZE
                       more than this much "dropped disk" traces in the map are reverted [1G]
  --artifact-bad SIZE  a bad area larger than this in one piece counts as a trace [16Mi]

File level (NTFS, ext2/3/4, FAT and exFAT; needs The Sleuth Kit; the image is never mounted):
  --extract            extract the intact files from the image (needs --extract-to)
  --extract-damaged    in a normal run, extract the damaged files too (their unreadable parts are
                       zeros); a later run skips such a file because size and time match, so
                       delete it before recovering it again
  --overwrite          replace conflicting regular files during extraction
  --verify             check every extracted file: it is synced, advised out of cache, read back and
                       compared by SHA-256 with what the image gave; hashes go to NAME.logs/manifest.sha256
                       (sha256sum -c format, paths relative to --extract-to). Files already in place are
                       checked too against the image; use --overwrite to replace a differing copy
  --extract-to DIR     where to extract; the tree of the volume is preserved
  --include PREFIX     extract only this path (a directory or a file) of the volume; repeatable
  --map SRC:DST        extract the volume path SRC (a directory or a file) into the directory DST
                       below --extract-to; repeatable. With --include or --map only the matching
                       files are extracted. With --inventory they only select the paths whose
                       counts are printed. Without them the whole volume is extracted,
                       system folders and swap files included.
  --owner USER[:GROUP] owner of extracted files [\$SUDO_USER, else root]
  --file-mode MODE     mode of extracted files [0664]
  --dir-mode MODE      mode of directories created by extraction [0775]
  --inventory          without the disk: lists of intact and incomplete files from the image, at
                       any stage of the rescue (with --extract: extract only the intact ones)
  --pick               targeted recovery: choose incomplete files in a window and read only them
  --file PART          targeted recovery without questions: incomplete files whose path contains
                       PART; repeatable
  --partition N        a whole-disk image holds several volumes the file level can read: use the
                       N-th partition of its table (the order of /dev/sdX1, /dev/sdX2, …; see mmls).
                       Without it the only such partition is used
  --first PATH         read the data of this path of the volume (a directory or a file) right after
                       the structures of the volume, before the rest of the disk; repeatable
  --no-meta-first      do not read the structures of an NTFS volume (\$MFT, directory indexes) and the
                       --first paths before everything else (this is the default for NTFS)
  --no-fs              imaging only: no file level at all

Silent garbage (the disk answered without an error, but with something else than data):
  --recheck-garbage    after copy, scrape and retry, scan the image once for the --suspect-pattern
                       (by default the sEDU service sector; the zero-run check is not used here),
                       mark those sectors as unreadable so that retry reads them again, and count
                       what is still garbage afterwards as unreadable (such files are damaged)
  --suspect-pattern RE a grep -P pattern (bytes, LC_ALL=C); files whose data matches are listed
                       as suspicious. Repeatable; replaces the built-in pattern
                       'sEDU\\x00{504}sEDU' (a service sector seen on a failing SMR drive)
  --suspect-zeros SIZE a run of zeros this long counts as garbage; 0 turns the check off [128Ki]
  --no-suspect-check   do not check the data at all

Safety and notifications:
  --no-readonly        do not set the kernel's read-only flag on the source while rescuing (it is
                       set by default, restored on exit and set again on a disk that comes back)
  --on-event PROGRAM   run PROGRAM on events, in the background and without a shell:
                       PROGRAM EVENT MESSAGE, plus LASTREAD_EVENT, LASTREAD_MESSAGE, LASTREAD_NAME,
                       LASTREAD_DIR, LASTREAD_STATUS in the environment (default from
                       \$LASTREAD_ON_EVENT). Events: started, hot, cooled, dropped, recovered,
                       power-cycle, zones-stuck, phase-done, done, interrupted, failed.
  --print-service      print a systemd unit that runs this command line (enable it and the rescue
                       continues by itself after a power cycle) and exit

Before a rescue:
  --triage             a short check of SOURCE that only reads: identity, SMART (if available),
                       kernel messages about the disk and about 9 one-megabyte sample reads, then
                       a verdict (green / yellow / red) and suggested options. Exit status 4 for
                       red. Needs root; no --dir needed. Stops sampling after two failures.
  --triage-timeout SEC wait this long for each sample read [20]

Looking at a rescue:
  --status             progress of a rescue from its map and logs, without touching the disk or
                       needing root: state, phase, rescued share, rate, rough time left, zones,
                       temperature, last events (find the image with --dir/--name like --inventory)
  --json               with --status: the same as JSON (needs jq), for monitoring

General:
  --dry-run            show the state and what would be done, run nothing
  -h, --help           this text
  --version            print the version

Exit status: 0 done, 1 error, 2 only stuck deferred zones are left (see --give-up-zones),
3 the disk does not answer and needs a power cycle, 130 interrupted (the next run continues).
EOF
}

# --- Small helpers -------------------------------------------------------------------------------

# Bytes from "1700G" (k/M/G/T are powers of 1000), "1Mi" (powers of 1024) or plain digits.
parse_size() {
  local v=${1/%k/K} out
  out="$(numfmt --from=auto -- "$v" 2>/dev/null)" || return 1
  [[ $out =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$out"
}
# A size for messages: GB for real disks, MB below 100 MB (test images).
gb() { awk -v b="$1" 'BEGIN { if (b >= 1e8) printf "%.1f GB", b / 1e9; else printf "%.1f MB", b / 1e6 }'; }
need_number() {
  local opt=$1 v=$2
  [[ $v =~ ^[0-9]+$ ]] || die "$opt: not a number: $v"
}
# Converts the size in the variable named VAR to bytes, in place.
size_option() {
  local -n ref=$1
  local out
  out="$(parse_size "$ref")" || die "$2: not a size: $ref (examples: 100M, 1Gi)"
  ref=$out
}

# --- Arguments -----------------------------------------------------------------------------------

parse_args() {
  while (($#)); do
    case $1 in
      --dir | --name | --stop | --resume | --interval | --temp-cmd | --smart-type | --min-rate | --skip-size | \
        --retries | --start-at | --add-zone | --rescan-pause | --rescan-attempts | \
        --kernel-timeout | --zone-margin | --zone-min-progress | --artifact-limit | --artifact-bad | \
        --extract-to | --include | --map | --owner | --file-mode | --dir-mode | --file | \
        --suspect-pattern | --suspect-zeros | --on-event | --triage-timeout | --partition | --first)
        [[ -n ${2:-} ]] || die "$1: a value is required (see --help)"
        case $1 in
          --dir) dir=$2 ;;
          --name) name=$2 ;;
          --stop) stop=$2 ;;
          --resume) resume=$2 ;;
          --interval) interval=$2 ;;
          --temp-cmd) temp_cmd=$2 ;;
          --smart-type) smart_type=$2 ;;
          --min-rate) min_rate=$2 ;;
          --skip-size) skip_size=$2 ;;
          --retries) retries=$2 ;;
          --start-at) start_at=$2 ;;
          --add-zone) add_zones+=("$2") ;;
          --rescan-pause) rescan_pause=$2 ;;
          --rescan-attempts) rescan_attempts=$2 ;;
          --kernel-timeout) kernel_timeout=$2 ;;
          --zone-margin) zone_margin=$2 ;;
          --zone-min-progress) zone_min_progress=$2 ;;
          --artifact-limit) artifact_limit=$2 ;;
          --artifact-bad) artifact_bad=$2 ;;
          --extract-to) extract_to=$2 ;;
          --include) includes+=("$2") ;;
          --map) maps+=("$2") ;;
          --owner) owner=$2 ;;
          --file-mode) file_mode=$2 ;;
          --dir-mode) dir_mode=$2 ;;
          --file) file_patterns+=("$2") ;;
          --suspect-pattern) suspect_patterns+=("$2") ;;
          --suspect-zeros) suspect_zeros=$2 ;;
          --on-event) event_cmd=$2 ;;
          --triage-timeout) triage_timeout=$2 ;;
          --partition) partition=$2 ;;
          --first) firsts+=("$2") ;;
        esac
        shift
        ;;
      --extract) extract=1 ;;
      --extract-damaged) extract_damaged=1 ;;
      --verify) verify=1 ;;
      --overwrite) overwrite=1 ;;
      --recheck-garbage) recheck_garbage=1 ;;
      --reverse) reverse=1 ;;
      --give-up-zones) give_up=1 ;;
      --inventory) inventory=1 ;;
      --pick) pick=1 ;;
      --no-rescan) rescan=0 ;;
      --no-temp) no_temp=1 ;;
      --no-fs) no_fs=1 ;;
      --no-meta-first) meta_first=0 ;;
      --no-suspect-check) suspect_check=0 ;;
      --no-readonly) readonly_flag=0 ;;
      --accept-source-change) accept_source_change=1 ;;
      --print-service) print_service=1 ;;
      --status) status=1 ;;
      --triage) triage=1 ;;
      --json) json=1 ;;
      --dry-run) DRY_RUN=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      --version)
        printf '%s %s\n' "$PROG" "$VERSION"
        exit 0
        ;;
      -*) die "unknown option: $1 (see --help)" ;;
      *)
        [[ -z $source_arg ]] || die "unexpected argument: $1 (see --help)"
        source_arg=$1
        ;;
    esac
    shift
  done
}

# Checks values, converts sizes to bytes, normalises include/map prefixes. Needs no device.
validate_args() {
  local n m size_re='[0-9]+([sbkMGTPEZYRQ]i?)?'
  need_number --stop "$stop"
  need_number --resume "$resume"
  need_number --interval "$interval"
  need_number --retries "$retries"
  need_number --rescan-pause "$rescan_pause"
  need_number --rescan-attempts "$rescan_attempts"
  need_number --kernel-timeout "$kernel_timeout"
  need_number --triage-timeout "$triage_timeout"
  [[ -z $partition ]] || { [[ $partition =~ ^[1-9][0-9]*$ ]] || die "--partition: a number from 1, not \"$partition\""; }
  if ((${#firsts[@]})); then
    ((meta_first)) || die "--first needs the metadata-first phase: it cannot be combined with --no-meta-first"
    ((!no_fs)) || die "--first needs the file level: it cannot be combined with --no-fs"
    ((!inventory && !status && !triage)) || die "--first only goes with a rescue"
    local i f
    for i in "${!firsts[@]}"; do
      f="${firsts[i]#/}"
      firsts[i]="${f%/}"
      [[ -n ${firsts[i]} ]] || die "--first: an empty path"
    done
  fi
  triage_timeout=$((10#$triage_timeout))
  ((triage_timeout > 0)) || die "--triage-timeout must be at least 1"
  # decimal even with a leading zero (08 is not an octal number here)
  stop=$((10#$stop)) resume=$((10#$resume)) interval=$((10#$interval)) retries=$((10#$retries))
  rescan_pause=$((10#$rescan_pause)) rescan_attempts=$((10#$rescan_attempts)) kernel_timeout=$((10#$kernel_timeout))
  # no returns at all is the same as --no-rescan
  ((rescan_attempts > 0)) || rescan=0
  ((interval > 0)) || die "--interval must be at least 1"
  ((resume < stop)) || die "--resume ($resume) must be lower than --stop ($stop)"
  [[ -z $skip_size || $skip_size =~ ^${size_re}(,${size_re})?$ ]] ||
    die "--skip-size: a size like 1Mi or 1Mi,1Gi, not \"$skip_size\""
  size_option zone_margin --zone-margin
  size_option zone_min_progress --zone-min-progress
  size_option artifact_limit --artifact-limit
  size_option artifact_bad --artifact-bad
  size_option suspect_zeros --suspect-zeros
  [[ $file_mode =~ ^[0-7]{3,4}$ ]] || die "--file-mode: an octal mode like 0664, not \"$file_mode\""
  [[ $dir_mode =~ ^[0-7]{3,4}$ ]] || die "--dir-mode: an octal mode like 0775, not \"$dir_mode\""
  ((!no_fs)) || ! ((extract || inventory || pick || ${#file_patterns[@]})) ||
    die "--no-fs cannot be combined with --extract, --inventory, --pick or --file"
  ((!inventory)) || ! ((pick || ${#file_patterns[@]})) ||
    die "--inventory cannot be combined with --pick or --file"
  ((!json)) || ((status)) || die "--json only goes with --status"
  ((status + inventory + print_service + triage <= 1)) || die "--status, --inventory, --triage and --print-service exclude each other"
  ((!triage)) || ((!extract && !pick && ${#file_patterns[@]} == 0)) || die "--triage only looks: it cannot be combined with --extract, --pick or --file"
  ((!status)) || ((!extract && !pick && ${#file_patterns[@]} == 0)) || die "--status only looks: it cannot be combined with --extract, --pick or --file"
  ((!extract_damaged)) || ((extract)) || die "--extract-damaged needs --extract"
  ((!extract_damaged)) || ! ((inventory || pick || ${#file_patterns[@]})) ||
    die "--extract-damaged only applies to a normal run, not to --inventory, --pick or --file"
  if ((extract)); then
    [[ -n $extract_to ]] || die "--extract needs --extract-to DIR"
  elif [[ -n $extract_to || -n $owner ]]; then
    die "--extract-to and --owner only make sense with --extract"
  fi
  ((!verify)) || ((extract)) || die "--verify only makes sense with --extract"
  ((!overwrite)) || ((extract)) || die "--overwrite only makes sense with --extract"
  ((${#includes[@]} + ${#maps[@]} == 0)) || ((extract || inventory)) ||
    die "--include and --map only make sense with --extract or --inventory"
  local i
  for i in "${!includes[@]}"; do
    n="${includes[i]#/}"
    includes[i]="${n%/}"
    [[ -n ${includes[i]} ]] || die "--include: an empty path"
  done
  for i in "${!maps[@]}"; do
    m=${maps[i]}
    [[ $m == ?*:?* ]] || die "--map: expected SRC:DST, not \"$m\""
    local src="${m%%:*}" dst="${m#*:}"
    src="${src#/}"
    src="${src%/}"
    dst="${dst#/}"
    dst="${dst%/}"
    [[ $dst != . ]] || dst=""
    [[ -n $src ]] || die "--map: an empty source in \"$m\""
    [[ "/$dst/" != *"/../"* ]] || die "--map: \"..\" is not allowed in the destination \"$m\""
    maps[i]="$src:$dst"
  done
  if [[ -n $start_at ]]; then
    start_at="$(parse_size "$start_at")" || die "--start-at: cannot parse the position (example: 1700G)"
  fi
  local z zfrom zto
  for z in "${add_zones[@]}"; do
    [[ $z == ?*-?* ]] || die "--add-zone: expected FROM-TO, for example 511G-521G"
    zfrom="$(parse_size "${z%%-*}")" || die "--add-zone: cannot parse \"$z\""
    zto="$(parse_size "${z#*-}")" || die "--add-zone: cannot parse \"$z\""
    ((zfrom < zto)) || die "--add-zone: FROM must be lower than TO in \"$z\""
  done
  # Silent-garbage pattern: user patterns replace the built-in one; zeros are added if requested.
  # PCRE allows a repeat count of at most 65535, hence the nested form for long runs of zeros.
  local -a parts=()
  if ((suspect_check)); then
    if ((${#suspect_patterns[@]})); then
      for n in "${suspect_patterns[@]}"; do parts+=("(?:$n)"); done
    else
      parts+=("$DEFAULT_SUSPECT_RE")
    fi
    if ((suspect_zeros > 0)); then
      local q=$((suspect_zeros / 32768)) r=$((suspect_zeros % 32768)) z_re=""
      ((q <= 65535)) || die "--suspect-zeros: too large"
      ((q == 0)) || z_re="(?:\\x00{32768}){$q}"
      ((r == 0)) || z_re+="\\x00{$r}"
      parts+=("$z_re")
    fi
  fi
  SUSPECT_RE=""
  for n in "${parts[@]}"; do SUSPECT_RE+="${SUSPECT_RE:+|}$n"; done
  if ((recheck_garbage)); then
    ((suspect_check)) || die "--recheck-garbage needs the data check: it cannot be combined with --no-suspect-check"
    # grep -b prints the offset of the first byte of a match; a lookahead keeps the printed match to one
    # byte, whatever the pattern (a match with NUL bytes or newlines would break the parsing).
    if ((${#suspect_patterns[@]})); then
      local alt=""
      for n in "${suspect_patterns[@]}"; do alt+="${alt:+|}(?:$n)"; done
      GARBAGE_RE="(?=$alt)[\\s\\S]"
    else
      GARBAGE_RE='sEDU(?=\x00{504}sEDU)'
    fi
    n=0
    grep -aP -- "$GARBAGE_RE" </dev/null >/dev/null 2>&1 || n=$?
    ((n != 2)) || die "the garbage pattern is not a valid grep -P pattern (--suspect-pattern): $GARBAGE_RE"
  fi
  if [[ -n $SUSPECT_RE ]]; then
    # grep exits with 2 on an invalid pattern (1 is "no match"): better to learn it now than at the
    # first extracted file, days into a rescue.
    n=0
    grep -aP -- "$SUSPECT_RE" </dev/null >/dev/null 2>&1 || n=$?
    ((n != 2)) || die "the data-check pattern is not a valid grep -P pattern (--suspect-pattern / --suspect-zeros): $SUSPECT_RE"
  fi
}

# --- Device --------------------------------------------------------------------------------------

# Device facts from SOURCE: kernel name, whole disk, SCSI host, transport. Called again after
# every return of a dropped disk, because the name can change.
resolve_device() {
  dev="$(readlink -f "$source_arg")"
  parent="$(lsblk -no PKNAME "$dev" 2>/dev/null | head -1)" || parent=""
  parent="${parent:-$(basename "$dev")}"
  whole="/dev/$parent"
  SCSI_HOST="$(readlink -f "/sys/block/$parent/device" 2>/dev/null | grep -o 'host[0-9]*' | tail -1)" || SCSI_HOST=""
  timeout_file="/sys/block/$parent/device/timeout"
  TRANSPORT="$(lsblk -dno TRAN "$whole" 2>/dev/null | head -1 | tr -d ' ')" || TRANSPORT=""
  SECTOR="$(blockdev --getss "$dev" 2>/dev/null)" || SECTOR=512
}
# Record identifiers without reading the disk contents. Partition start distinguishes equal-sized
# partitions on the same disk. An empty hardware ID is not treated as proof of identity.
source_identity() {
  local wwn serial start="whole"
  wwn="$(lsblk -dn -o WWN "$whole" 2>/dev/null | head -1 | xargs)" || wwn=""
  serial="$(lsblk -dn -o SERIAL "$whole" 2>/dev/null | head -1 | xargs)" || serial=""
  if [[ $dev != "$whole" ]]; then
    start="$(cat "/sys/class/block/${dev##*/}/start" 2>/dev/null)" || start="unknown"
  fi
  printf 'size=%s\nsector=%s\nstart=%s\nwwn=%s\nserial=%s\n' "$PART_SIZE" "$SECTOR" "$start" "$wwn" "$serial"
  if [[ -z $wwn && -z $serial && $source_arg == /dev/disk/by-id/* ]]; then
    printf 'path=%s\n' "$source_arg"
  fi
}
identity_check() {
  local expected=$1 current=$2 key old new
  [[ -f $expected ]] || return 0
  for key in size sector start wwn serial path; do
    old="$(sed -n "s/^$key=//p" "$expected")"
    [[ -n $old ]] || continue
    new="$(sed -n "s/^$key=//p" "$current")"
    [[ $old == "$new" ]] || { warn "source identity changed or is unavailable: $key (was '$old', now '${new:-unavailable}')"; return 1; }
  done
}
identity_prepare() {
  source_identity >"$TMPD/source.identity"
  if [[ -f $logs/source.identity ]]; then
    if ! identity_check "$logs/source.identity" "$TMPD/source.identity"; then
      ((accept_source_change)) || die "source identity does not match; verify the device, then use --accept-source-change to adopt it"
      warn "adopting the changed source identity; make sure this is the same source"
    fi
  elif [[ -f $map ]]; then
    warn "this existing rescue has no recorded source identity; verify the source before continuing"
  fi
  if grep -Fx 'start=unknown' "$TMPD/source.identity" >/dev/null; then
    warn "partition start is unavailable; equal-sized partitions may not be distinguishable"
  fi
  if ! grep -E '^(wwn|serial|path)=.+' "$TMPD/source.identity" >/dev/null; then
    warn "no stable source identifier is available; identity cannot be reliably checked on resume"
  fi
}
# A map may claim data that no longer exists in a missing or truncated image.
validate_image_map() {
  local pos size state end=0
  [[ -f $map ]] || return 0
  [[ -f $img ]] || die "map exists but image is missing: $img; restore the matching image before continuing"
  while read -r pos size state; do
    [[ $state == + ]] || continue
    ((pos + size <= end)) || end=$((pos + size))
  done < <(awk '!/^#/ && ++n > 1' "$map")
  (( $(stat -c %s "$img") >= end )) || die "image $img is shorter than the rescued data recorded in $map; restore the matching image"
}
# lsblk -s returns the device and all of its underlying devices, including every branch of DM/RAID.
# Compare major:minor, not names, so aliases and bind mounts do not hide shared devices.
check_destination() {
  local target=$1 source_nodes target_nodes mm fstype target_dev
  source_nodes="$(lsblk -s -n -r -o MAJ:MIN "$dev" 2>/dev/null | sort -u)" || source_nodes=""
  mm="$(findmnt -n -o MAJ:MIN --target "$target" 2>/dev/null | head -1 | xargs)" || mm=""
  fstype="$(findmnt -n -o FSTYPE --target "$target" 2>/dev/null | head -1 | xargs)" || fstype=""
  target_dev="$(lsblk -n -r -p -o MAJ:MIN,NAME 2>/dev/null | awk -v mm="$mm" '$1 == mm {print $2; exit}')" || target_dev=""
  target_nodes=""
  if [[ -n $target_dev ]]; then
    target_nodes="$(lsblk -s -n -r -o MAJ:MIN "$target_dev" 2>/dev/null | sort -u)" || target_nodes=""
  fi
  if [[ -z $source_nodes || -z $target_nodes ]]; then
    warn "cannot determine the underlying disks for $target; verify it is not on the source disk"
    return 0
  fi
  if comm -12 <(printf '%s\n' "$source_nodes") <(printf '%s\n' "$target_nodes") | grep . >/dev/null; then
    die "$target is on the same disk as the source (shared underlying block device)"
  fi
  case $fstype in
    btrfs | zfs | bcachefs) warn "cannot verify every member of $fstype at $target; check that no member is on the source disk" ;;
  esac
}

# Why a host rescan cannot bring this disk back; empty if it can. Rescanning a SCSI host re-polls
# the ports of a libata (SATA) or SAS host. It cannot revive a USB device (the USB layer has
# dropped it) or an NVMe controller.
rescan_unavailable_reason() {
  [[ -n $SCSI_HOST ]] || {
    printf 'the device has no SCSI host in sysfs'
    return 0
  }
  case $TRANSPORT in
    "" | sata | ata | sas) ;;
    *) printf 'transport "%s" is not rescannable' "$TRANSPORT" ;;
  esac
}
# "- - -" into the scan file of the SCSI host makes the kernel poll the port again. Waits until the
# device path appears.
rescan_host() {
  local host=$1 i
  [[ -n $host && -w /sys/class/scsi_host/$host/scan ]] || return 1
  echo "- - -" >"/sys/class/scsi_host/$host/scan" 2>/dev/null || true
  udevadm settle -t 60 2>/dev/null || true
  for i in $(seq 1 30); do
    [[ ! -b $source_arg ]] || return 0
    sleep 2
  done
  return 1
}

# --- Journal -------------------------------------------------------------------------------------

# ddrescuelog prints with the locale of the process; LC_ALL=C is set for the whole script.
status_short() {
  [[ -f $map ]] || {
    printf 'no map yet'
    return 0
  }
  local st
  st="$(ddrescuelog -t "$map")"
  printf 'rescued %s, unreadable %s' \
    "$(sed -n 's/^ *rescued: *\([^,]*\),.*( *\([0-9.]*%\)).*/\1 (\2)/p' <<<"$st")" \
    "$(sed -n 's/^ *bad-sector: *\([^,]*\),.*/\1/p' <<<"$st")"
}
summary() {
  [[ -f $map ]] || return 0
  ddrescuelog -t "$map" | tee -a "$LOG"
}
zones_text() {
  local s e _
  while read -r s e _; do printf '%s – %s; ' "$(gb "$s")" "$(gb "$e")"; done <"$zones"
}

# --- Disk and temperature ------------------------------------------------------------------------

# Prints the temperature in whole °C; fails if there is none.
temperature() {
  local out t
  ((TEMP_GUARD)) || return 1
  if [[ -n $temp_cmd ]]; then
    out="$(timeout 30 "$temp_cmd" "$whole")" || return 1
  else
    # smartctl's exit status is a bit mask that also reports a worn disk, so it is ignored: the
    # JSON either has the temperature or it does not.
    out="$(timeout 30 smartctl -j -A "${SMART_ARGS[@]}" "$whole" 2>/dev/null || true)"
    out="$(jq -er '.temperature.current' <<<"$out" 2>/dev/null)" || return 1
  fi
  t="${out%%.*}"
  [[ $t =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$((10#$t))"
}
# Chooses the temperature source once: --temp-cmd, smartctl, smartctl -d sat. Without any, the
# tool runs without the watchdog (and says so).
detect_temperature_source() {
  local t type
  TEMP_GUARD=1 SMART_ARGS=()
  if ((no_temp)); then
    TEMP_GUARD=0
    warn "temperature is not watched (--no-temp)"
    return 0
  fi
  if [[ -n $temp_cmd ]]; then
    t="$(temperature)" || t=""
    [[ -n $t ]] || {
      TEMP_GUARD=0
      warn "--temp-cmd gave no temperature: running without the temperature watchdog"
      return 0
    }
    info "temperature from $temp_cmd: $t °C"
    return 0
  fi
  if ! command -v smartctl >/dev/null || ! command -v jq >/dev/null; then
    TEMP_GUARD=0
    warn "smartctl or jq is missing: running without the temperature watchdog (apt install smartmontools jq)"
    return 0
  fi
  local -a candidates=("${smart_type:-}")
  [[ -n $smart_type ]] || candidates+=(sat)
  for type in "${candidates[@]}"; do
    SMART_ARGS=()
    [[ -z $type ]] || SMART_ARGS=(-d "$type")
    t="$(temperature)" || t=""
    if [[ -n $t ]]; then
      info "temperature from smartctl${type:+ (-d $type)}: $t °C"
      return 0
    fi
  done
  SMART_ARGS=()
  TEMP_GUARD=0
  warn "no temperature from smartctl for $whole: running without the temperature watchdog (try --smart-type, --temp-cmd or --no-temp)"
}
# The device is alive: sysfs state is "running" and one block can be read directly.
device_ok() {
  local state="/sys/block/$parent/device/state"
  [[ ! -r $state || "$(cat "$state")" == running ]] || return 1
  timeout 300 dd if="$dev" of=/dev/null bs=4096 count=1 iflag=direct status=none 2>/dev/null
}
die_device() {
  local why=""
  if ((!rescan)); then
    why=" (rescanning is off)"
  elif [[ -n "$(rescan_unavailable_reason)" ]]; then
    why=" (automatic return is not available: $(rescan_unavailable_reason))"
  else
    why=" and rescanning did not bring it back"
  fi
  local msg="the disk does not answer ($dev)$why. Power the machine fully off, switch it on and run the same command again: it continues where it stopped"
  notify power-cycle "$msg"
  die_code 3 "$msg"
}
# Brings a dropped disk back without a power cycle: pause, rescan of the SCSI host, wait for the
# device, then the usual direct read. At most rescan_attempts times in a row without progress.
recover_device() {
  local why
  ((rescan)) || return 1
  why="$(rescan_unavailable_reason)"
  if [[ -n $why ]]; then
    note "cannot bring the disk back by rescanning: $why"
    return 1
  fi
  recoveries=$((recoveries + 1))
  if ((recoveries > rescan_attempts)); then
    note "the disk keeps dropping: $rescan_attempts returns in a row without progress"
    return 1
  fi
  note "the disk dropped — rescanning $SCSI_HOST in ${rescan_pause}s (attempt $recoveries of $rescan_attempts)"
  sleep "$rescan_pause"
  rescan_host "$SCSI_HOST" || return 1
  resolve_device
  PART_SIZE="$(blockdev --getsize64 "$dev")" || return 1
  source_identity >"$TMPD/recovered.identity"
  if ! identity_check "$TMPD/source.identity" "$TMPD/recovered.identity"; then
    # cleanup must not change the flags or timeout of a different device.
    RO_SET=0 orig_timeout=""
    die "returned device identity does not match the original source; stopped before reading"
  fi
  raise_kernel_timeout
  device_ok || return 1
  set_readonly
  note "the disk is back: $dev"
  notify recovered "the disk is back: $dev"
}
# Raises the kernel's command timeout of the (new) device to --kernel-timeout; never lowers it.
raise_kernel_timeout() {
  local cur
  ((kernel_timeout > 0)) || return 0
  [[ -w $timeout_file ]] || return 0
  cur="$(cat "$timeout_file")"
  if [[ $cur =~ ^[0-9]+$ ]] && ((cur < kernel_timeout)); then echo "$kernel_timeout" >"$timeout_file"; fi
}
wait_cool() {
  local t last=-1000
  while :; do
    t="$(temperature)" || t=""
    LAST_TEMP=$t
    RATE=0 RATE_T=() RATE_B=()
    write_state cooling
    if [[ -z $t ]]; then
      warn "temperature unavailable — pausing for 5 minutes"
      sleep 300
      return 0
    fi
    if ((t <= resume)); then
      note "temperature $t °C — continuing"
      notify cooled "temperature $t °C — continuing"
      return 0
    fi
    if ((SECONDS - last >= 300)); then
      note "cooling down: $t °C, continuing at $resume °C"
      last=$SECONDS
    fi
    sleep "$interval"
  done
}

# --- Traces of a dropped disk ----------------------------------------------------------------------

# Bytes in traces: non-trimmed, non-scraped and "bad" areas larger than artifact_bad.
artifact_bytes() {
  local pos size st total=0
  [[ -f $map ]] || {
    echo 0
    return 0
  }
  while read -r pos size st; do
    if [[ $st == [*/] ]] || { [[ $st == - ]] && ((size > artifact_bad)); }; then total=$((total + size)); fi
  done < <(awk '!/^#/ && ++n > 1' "$map")
  echo "$total"
}
# Returns traces to "not tried": ddrescue then reads them again the normal way, not sector by
# sector. The previous map is kept next to it (.before-revert).
revert_artifacts() {
  local line pos size st n=0
  [[ ! -e $map.before-revert ]] || mv -f "$map.before-revert" "$map.before-revert.prev"
  cp -p "$map" "$map.before-revert"
  while IFS= read -r line; do
    if [[ $line != \#* ]] && ((++n > 1)); then
      read -r pos size st <<<"$line"
      if [[ $st == [*/] ]] || { [[ $st == - ]] && ((size > artifact_bad)); }; then line="$pos  $size  ?"; fi
    fi
    printf '%s\n' "$line"
  done <"$map" >"$map.new"
  mv "$map.new" "$map"
  note "traces of the dropped disk returned to \"not tried\": $(status_short)"
}

# --- Deferred zones ------------------------------------------------------------------------------

# A zone is a line "START END DIRECTION FAILURES" (bytes; f — the next attempt reads from the
# start of the zone, r — from the end; failures — hangs in a row with too little progress).
zones_exist() { [[ -s $zones ]]; }
zones_abandoned() { [[ -e $logs/zones.abandoned ]]; }
# Adds the zone [FROM, TO) and merges overlapping ones (a merged zone starts over).
zone_put() {
  local start=$1 end=$2
  start=$((start / SECTOR * SECTOR))
  end=$(((end < PART_SIZE ? end : PART_SIZE) / SECTOR * SECTOR))
  { [[ ! -f $zones ]] || cat "$zones"; printf '%s %s f 0\n' "$start" "$end"; } | sort -n |
    awk '{ if (n && $1 <= e) { if ($2 > e) e = $2; d = "f"; k = 0 }
           else { if (n) print s, e, d, k; s = $1; e = $2; d = $3; k = $4; n = 1 } }
         END { if (n) print s, e, d, k }' >"$zones.new"
  mv "$zones.new" "$zones"
}
# The next zone for the zones phase: the first one where progress is still possible.
zone_next() { awk '$4 < 2 {print; exit}' "$zones"; }
# Bounds of what is still unread in [S, E) according to the map: the first start and the last end
# of blocks ?, * and /. Unreadable sectors (-) do not count — the retry phase rechecks them.
# Prints "START END"; "E E" if nothing is unread.
unrescued_span() {
  local zs=$1 ze=$2 pos size st b0 b1 first="" last=""
  while read -r pos size st; do
    b0=$((pos)) b1=$((pos + size))
    ((b1 > zs)) || continue
    ((b0 < ze)) || break
    [[ $st == [?*/] ]] || continue
    [[ -n $first ]] || first=$((b0 > zs ? b0 : zs))
    last=$((b1 < ze ? b1 : ze))
  done < <(awk '!/^#/ && ++n > 1' "$map")
  printf '%s %s\n' "${first:-$ze}" "${last:-$ze}"
}
# The disk hung near P. In the zones phase the current zone narrows by exactly what was rescued
# (by the map, not by the rate log: its granularity is coarse and that looped forever), from the
# side the reading came from. In other phases a new zone ±zone_margin is deferred around P.
zone_hang() {
  local p=$1 phase=$2 s e d k msg="" first last
  if [[ $phase == zones && -n $ZS ]]; then
    read -r first last < <(unrescued_span "$ZS" "$ZE")
    while read -r s e d k; do
      if [[ $s == "$ZS" && $e == "$ZE" ]]; then
        if [[ $ZD == f ]]; then s=$((first / SECTOR * SECTOR)); else e=$(((last + SECTOR - 1) / SECTOR * SECTOR)); fi
        if ((e <= s)); then
          # stdout of this loop is the new zone list: the message must not go there.
          note "deferred zone $(gb "$ZS") – $(gb "$ZE") is fully read" >&2
          continue
        fi
        if (((ZE - ZS) - (e - s) < zone_min_progress)); then k=$((k + 1)); else k=0; fi
        if [[ $ZD == f ]]; then d=r; else d=f; fi
        msg="the disk hung in a deferred zone near $(gb "$p"); the zone is now $(gb "$s") – $(gb "$e")"
        ((k == 0)) || msg+=", almost no progress ($k of 2)"
      fi
      printf '%s %s %s %s\n' "$s" "$e" "$d" "$k"
    done <"$zones" >"$zones.new"
    mv "$zones.new" "$zones"
    [[ -s $zones ]] || rm -f "$zones"
    [[ -z $msg ]] || note "$msg"
  else
    zone_put "$((p > zone_margin ? p - zone_margin : 0))" "$((p + zone_margin))"
    note "the disk hung near $(gb "$p"): deferred zones — $(zones_text)"
  fi
}
# Where ddrescue will start reading: the position in the status line of the map. Without this it
# continues from where it stopped — the hang position, not the edge of the zone.
set_map_pos() {
  local line n=0
  while IFS= read -r line; do
    if [[ $line != \#* ]] && ((++n == 1)); then line="$(printf '0x%X  ?  1' "$1")"; fi
    printf '%s\n' "$line"
  done <"$map" >"$map.new"
  mv "$map.new" "$map"
}
map_pos() { awk '!/^#/ {print $1; exit}' "$map"; }
# Where the disk hung: the last position with a non-zero rate in the rate log of the run.
# (ddrescue buffers the rate log and writes it on exit, so call this after the run.)
hang_position() {
  [[ -f $1 ]] || return 0
  awk '!/^#/ && NF >= 3 { if (first == "") first = $2; if ($3 > 0) last = $2 }
       END { print (last != "" ? last : first) }' "$1"
}
# The ddrescue domain (-m). "outside": everything except the zones; otherwise only the zone
# [START, END).
write_domain() {
  local pos=0 s e _ zin='?' zout='+'
  {
    printf '# %s: ddrescue domain\n0x00000000  +  1\n' "$PROG"
    if [[ $1 == outside ]]; then
      while read -r s e _; do
        ((s <= pos)) || printf '0x%X  0x%X  %s\n' "$pos" "$((s - pos))" "$zout"
        printf '0x%X  0x%X  %s\n' "$s" "$((e - s))" "$zin"
        pos=$e
      done < <(sort -n "$zones")
    else
      zin='+' zout='?'
      ((${1} == 0)) || printf '0x00000000  0x%X  %s\n' "$1" "$zout"
      printf '0x%X  0x%X  %s\n' "$1" "$(($2 - $1))" "$zin"
      pos=$2
    fi
    ((pos >= PART_SIZE)) || printf '0x%X  0x%X  %s\n' "$pos" "$((PART_SIZE - pos))" "$zout"
  } >"$domain"
}

# --- Phases --------------------------------------------------------------------------------------

# Does the map have blocks of this kind (non-tried, non-trimmed, non-scraped, bad-sector) outside
# the zones? If the zones cover the whole device there is nothing outside.
has() {
  local -a dom=()
  if zones_exist && (($(awk '{s += $2 - $1} END {printf "%.0f", s}' "$zones") >= PART_SIZE)); then return 1; fi
  if zones_exist; then
    write_domain outside
    dom=(-m "$domain")
  fi
  ! ddrescuelog "${dom[@]}" -t "$map" | grep -E "^ *$1: +0 B," >/dev/null
}
next_phase() {
  if meta_pending; then
    echo meta
  elif [[ ! -f $map ]] || has non-tried; then
    echo copy
  elif has non-trimmed || has non-scraped; then
    echo scrape
  elif has bad-sector && [[ ! -e $logs/retry.done ]]; then
    echo retry
  elif ((recheck_garbage)) && [[ ! -e $logs/garbage.done ]]; then
    echo garbage
  elif zones_exist && ! zones_abandoned; then
    if [[ -n "$(zone_next)" ]]; then echo zones; else echo zones-stuck; fi
  elif [[ ! -e $logs/report.done ]]; then
    echo report
  elif ((extract)) && [[ ! -e $logs/extract.done ]]; then
    echo extract
  else
    echo "done"
  fi
}

# Runs ddrescue for a phase under the watchdog. Exit code 10 — stopped because of the temperature,
# 11 — the disk dropped; otherwise the exit code of ddrescue.
run_ddrescue() {
  local phase=$1 t last=$SECONDS paused=0 rc=0
  CUR_PHASE=$phase
  RATE_T=() RATE_B=()
  write_state running
  RATES="$logs/rates-$(date '+%Y%m%d-%H%M%S')-$phase.log"
  local -a args=(-d -b "$SECTOR" -T 10m --log-events="$logs/events.log" --log-rates="$RATES")
  case $phase in
    copy)
      # From the same place (or --start-at on the first run), but always from pass 1: ddrescue
      # would continue from the pass recorded in the map, and in the last one (5) it skips neither
      # errors nor slow places (-a has no effect).
      if [[ -n $TARGET_RANGES ]]; then
        set_map_pos 0
      elif [[ -n $start_at ]]; then
        [[ -f $map ]] || printf '# %s\n0x00000000  ?  1\n0x00000000  0x%X  ?\n' "$PROG" "$PART_SIZE" >"$map"
        set_map_pos "$start_at"
        note "reading starts at $(gb "$start_at")"
        start_at=""
      elif [[ -f $map ]]; then
        set_map_pos "$(map_pos)"
      fi
      args+=(-n)
      [[ -z $min_rate ]] || args+=(-a "$min_rate")
      [[ -z $skip_size ]] || args+=(-K "$skip_size")
      ((!reverse)) || args+=(-R)
      ;;
    zones)
      read -r ZS ZE ZD _ < <(zone_next)
      args+=(-n)
      if [[ $ZD == f ]]; then set_map_pos "$ZS"; else
        set_map_pos "$ZE"
        args+=(-R)
      fi
      note "deferred zone $(gb "$ZS") – $(gb "$ZE"), reading from the $([[ $ZD == f ]] && echo start || echo end)"
      ;;
    retry) args+=(-r "$retries") ;;
  esac
  if [[ -n $TARGET_RANGES ]]; then
    write_ranges_domain "$TARGET_RANGES"
    args+=(-m "$domain")
  elif [[ $phase == zones ]]; then
    write_domain "$ZS" "$ZE"
    args+=(-m "$domain")
  elif zones_exist; then
    write_domain outside
    args+=(-m "$domain")
  fi
  note "phase $phase: ddrescue ${args[*]} $dev $img $map"
  # fd 8 holds the run lock: children must not inherit it, or a child that outlives the tool
  # (the sleep below, a tee) would keep the next run out.
  ddrescue "${args[@]}" "$dev" "$img" "$map" 8>&- > >(tee -a "$logs/ddrescue-$phase.log" 8>&-) 2>&1 &
  DD_PID=$!
  while kill -0 "$DD_PID" 2>/dev/null; do
    sleep "$interval" 8>&- &
    wait $! || true
    kill -0 "$DD_PID" 2>/dev/null || break
    if ! device_ok; then
      note "the disk dropped — stopping ddrescue before it marks the rest as bad"
      kill -TERM "$DD_PID" 2>/dev/null || true
      wait "$DD_PID" 2>/dev/null || true
      DD_PID=""
      return 11
    fi
    t="$(temperature)" || t=""
    LAST_TEMP=$t
    sample_progress
    write_state running
    if [[ -n $t ]] && ((t >= stop)); then
      note "temperature $t °C ≥ $stop °C — stopping ddrescue, the map is saved"
      # TERM, not INT: background processes of a script without job control ignore SIGINT.
      kill -TERM "$DD_PID"
      paused=1
      notify hot "temperature $t °C ≥ $stop °C: ddrescue stopped until $resume °C"
      break
    fi
    if ((SECONDS - last >= 300)); then
      # On a terminal ddrescue's own display shows the progress: only the log gets the line.
      if [[ -t 1 ]]; then
        printf '%s temperature %s °C, %s\n' "$(date '+%F %T')" "${t:-?}" "$(status_short)" >>"$LOG"
      else
        note "temperature ${t:-?} °C, $(status_short)"
      fi
      last=$SECONDS
    fi
  done
  wait "$DD_PID" || rc=$?
  DD_PID=""
  printf '\n'
  if ((paused)); then return 10; fi
  return "$rc"
}

# Unread parts of the map as "START END" lines (bytes), adjacent pieces merged. TYPES — which
# blocks count, for example "-" or "?*/-".
map_ranges() {
  local types=$1 pos size st b0 b1 cs="" ce=""
  while read -r pos size st; do
    b0=$((pos)) b1=$((pos + size))
    if [[ $types == *"$st"* ]]; then
      if [[ -n $cs ]] && ((b0 <= ce)); then ce=$b1; else
        [[ -z $cs ]] || echo "$cs $ce"
        cs=$b0 ce=$b1
      fi
    elif [[ -n $cs ]]; then
      echo "$cs $ce"
      cs=""
    fi
  done < <(awk '!/^#/ && ++n > 1' "$map")
  [[ -z $cs ]] || echo "$cs $ce"
}
# Device size from the end of a map.
map_size() {
  awk '!/^#/ && ++n > 1 {p = $1; s = $2} END {print p, s}' "$1" | { read -r p s; echo $((p + s)); }
}

# --- File level (NTFS through The Sleuth Kit) ------------------------------------------------------

# Until ddrescue reaches the end, the image is shorter than the partition; extend it (sparse) so
# that reads past its end do not abort parsing of the volume. The data of the image is unchanged.
# Sets FS_STATE (and says why when the file level is not possible) and always returns 0, so that it
# runs with errexit in effect: skipped — this image has no file level (--no-fs, not NTFS, a partition
# table, unreadable boot sector); missing — The Sleuth Kit is not installed (fixable, so the callers
# must not record the file level as done).
image_prepare() {
  FS_STATE=skipped
  ((!no_fs)) || return 0
  if ! tsk_available; then
    FS_STATE=missing
    warn "The Sleuth Kit (fls, istat, icat, fsstat, ils, mmls) is missing: no file level (apt install sleuthkit)"
    return 0
  fi
  if (($(stat -c %s "$img") < PART_SIZE)); then truncate -s "$PART_SIZE" "$img" || die "cannot extend $img to the size of the device"; fi
  if ! fs_locate; then return 0; fi
  # CLUSTER is the unit of the pieces file_map reports: the cluster of NTFS, the block of ext, the
  # sector of FAT/exFAT (istat -r lists their runs in sectors)
  case $FS_KIND in
    ntfs) CLUSTER="$(awk -F': *' '/^Cluster Size/ {print $2; exit}' <<<"$FSOUT")" ;;
    ext) CLUSTER="$(awk -F': *' '/^Block Size:/ {print $2; exit}' <<<"$FSOUT")" ;;
    fat) CLUSTER="$(awk -F': *' '/^Sector Size:/ {print $2; exit}' <<<"$FSOUT")" ;;
  esac
  if [[ ! $CLUSTER =~ ^[0-9]+$ ]]; then
    note "the block size of the volume is unknown (fsstat): no file level"
    return 0
  fi
  FS_STATE=ok
}
# The family of a file system type (as fsstat names it) that the file level can read:
# ntfs, ext (ext2/3/4), fat (FAT12/16/32 and exFAT); empty for the rest.
fs_kind_of() {
  case "${1,,}" in
    ntfs) echo ntfs ;;
    ext2 | ext3 | ext4) echo ext ;;
    fat12 | fat16 | fat32 | exfat) echo fat ;;
  esac
}
# The file system type in fsstat output.
fs_type() { awk -F': *' '/^File System Type:/ {print $2; exit}' <<<"$1"; }
# Where the volume starts in the image: TSK takes the offset in 512-byte sectors.
tsk_set_offset() {
  FS_OFFSET=$1
  TSK_O=()
  ((FS_OFFSET == 0)) || TSK_O=(-o "$((FS_OFFSET / 512))")
}
# FAT and exFAT are recognised from the boot sector: fsstat of The Sleuth Kit 4.12 does not return
# on exFAT and is slow on large FAT volumes. boot_probe OFFSET prints "TYPE BYTES_PER_SECTOR" for a
# FAT12/16/32 or exFAT boot sector at that byte offset of the image; fails for anything else.
boot_probe() {
  local o=$1 bps oem t
  oem="$(dd if="$img" bs=1 skip=$((o + 3)) count=8 status=none 2>/dev/null)" || return 1
  if [[ $oem == "EXFAT   " ]]; then
    bps=$((1 << $(img_le $((o + 108)) 1)))
    ((bps >= 512 && bps <= 4096)) || return 1
    echo "exFAT $bps"
    return 0
  fi
  bps="$(img_le $((o + 11)) 2)"
  ((bps == 512 || bps == 1024 || bps == 2048 || bps == 4096)) || return 1
  t="$(dd if="$img" bs=1 skip=$((o + 82)) count=8 status=none 2>/dev/null)" || return 1
  if [[ $t == "FAT32   " ]]; then
    echo "FAT32 $bps"
    return 0
  fi
  t="$(dd if="$img" bs=1 skip=$((o + 54)) count=8 status=none 2>/dev/null)" || return 1
  case $t in
    "FAT12   " | "FAT16   ")
      echo "${t%% *} $bps"
      return 0
      ;;
  esac
  return 1
}
tsk_fsstat() { timeout 120 fsstat "$@"; }
# The fsstat-style description of the file system at byte OFFSET of the image (synthesised for
# FAT/exFAT); fails if there is none.
fs_probe() {
  local o=$1 bp t bps out
  if bp="$(boot_probe "$o")"; then
    read -r t bps <<<"$bp"
    printf 'File System Type: %s\nSector Size: %s\n' "$t" "$bps"
    return 0
  fi
  out="$(tsk_fsstat -o $((o / 512)) "$img" 2>/dev/null)" || return 1
  printf '%s\n' "$out"
}
# Finds the NTFS volume in the image: the image itself (a partition image), or a partition of a
# whole-disk image (mmls). Sets FS_OFFSET/TSK_O and FSOUT (fsstat output); returns 1, after saying
# why, if there is no usable volume.
fs_locate() {
  local fstype mm unit s t i n=0 label
  local -a starts=() types=() usable=()
  tsk_set_offset 0
  FSOUT="$(fs_probe 0)" || FSOUT=""
  fstype="$(fs_type "$FSOUT")"
  FS_KIND="$(fs_kind_of "$fstype")"
  if [[ -n $FS_KIND ]]; then return 0; fi
  if [[ -n $fstype ]]; then
    note "the file system is $fstype: the file level supports NTFS, ext2/3/4 and FAT/exFAT only; the image itself is fine"
    return 1
  fi
  if mm="$(mmls -b "$SECTOR" "$img" 2>/dev/null)" && [[ -n $mm ]]; then
    unit="$(sed -n 's/^Units are in \([0-9]*\)-byte sectors.*/\1/p' <<<"$mm")"
    unit=${unit:-512}
    while read -r s; do
      starts+=($((10#$s * unit)))
    done < <(awk '/^[0-9]+:/ && $2 != "Meta" && $2 != "-------" {print $3}' <<<"$mm")
    for i in "${!starts[@]}"; do
      t="$(fs_type "$(fs_probe "${starts[i]}")")"
      types+=("${t:-unknown}")
      [[ -z "$(fs_kind_of "$t")" ]] || usable+=("$i")
    done
    if ((${#starts[@]} == 0)); then
      note "the partition table of the image lists no partitions: no file level"
      return 1
    fi
    if [[ -n $partition ]]; then
      i=$((partition - 1))
      if ((i >= ${#starts[@]})); then
        note "--partition $partition: the image has only ${#starts[@]} partitions"
        return 1
      fi
      if [[ -z "$(fs_kind_of "${types[i]}")" ]]; then
        note "--partition $partition is ${types[i]}: the file level supports NTFS, ext2/3/4 and FAT/exFAT only"
        return 1
      fi
    elif ((${#usable[@]} == 1)); then
      i=${usable[0]}
    elif ((${#usable[@]} == 0)); then
      note "no partition with a supported file system in the image (partitions: ${types[*]}): no file level"
      return 1
    else
      label=""
      for n in "${usable[@]}"; do label+=" $((n + 1))"; done
      note "several partitions with a supported file system in the image (partitions$label): choose one with --partition N"
      return 1
    fi
    tsk_set_offset "${starts[i]}"
    FSOUT="$(fs_probe "${starts[i]}")" || FSOUT=""
    FS_KIND="$(fs_kind_of "$(fs_type "$FSOUT")")"
    note "the file level works on partition $((i + 1)) of the image ($(fs_type "$FSOUT"), offset ${starts[i]} bytes)"
    return 0
  fi
  if blkid -p -o value -s PTTYPE "$img" 2>/dev/null | grep . >/dev/null; then
    note "the image has a partition table that mmls cannot read: no file level"
  else
    note "the image holds no file system the file level can read (NTFS, ext2/3/4, FAT/exFAT): no file level; the image itself is fine"
  fi
  return 1
}
tsk_available() {
  local c
  for c in fls istat icat fsstat ils mmls; do command -v "$c" >/dev/null || return 1; done
}
# Regular files of the volume: "ID<TAB>PATH" (ID — the MFT entry with a data attribute, for icat).
# System files ($…) and named streams (a path with ":") are skipped. A directory entry that points
# to an MFT entry which is readable and *not in use* (a stale index record of a deleted file) is
# skipped too; if the entry cannot be read at all it is kept, and file_map will call it unknown —
# a file must not vanish from the lists because its MFT entry is damaged. fls builds paths by
# walking directories; an allocated MFT entry that the walk does not reach is listed anyway, as
# "?/NAME", and counts as incomplete: losing a file silently is worse. Entries below 24 are system
# entries. A fragmented file is listed by fls twice (once per attribute, see file_map) — one line
# per entry and path remains. A name with a tab cannot be put in the list: it becomes "?/entry N".
tsk_files() {
  local listed="$TMPD/fls.txt" alloc="$TMPD/ils-alloc.txt" i out name id path check first=24 is_ntfs=1
  fls -r -p -u "${TSK_O[@]}" "$img" >"$listed" 2>/dev/null || true
  # The first user entry: NTFS keeps 24 system entries, ext 11 (lost+found). FAT/exFAT have no entry
  # table that ils could list, so unlisted entries are not looked for there.
  case $FS_KIND in
    ext)
      first=11
      is_ntfs=0
      ;;
    fat)
      first=999999999999
      is_ntfs=0
      ;;
  esac
  # ils only saves work: entries it does not list as allocated are verified with istat below.
  ils -a "${TSK_O[@]}" "$img" 2>/dev/null | awk -F'|' -v first="$first" 'NR > 3 && $2 == "a" && $1 >= first {print $1}' | sort -u >"$alloc" || true
  if ((is_ntfs)) && [[ ! -s $alloc && -s $listed ]]; then
    warn "ils listed no allocated entries: every entry is checked with istat, and unlisted entries cannot be found"
  fi
  while IFS=$'\t' read -r id path check; do
    if [[ $check == 1 ]]; then
      out="$(istat "${TSK_O[@]}" "$img" "${id%%-*}" 2>/dev/null)" || out=""
      ! grep '^Not Allocated File' <<<"$out" >/dev/null || continue
    fi
    printf '%s\t%s\n' "$id" "$path"
  done < <(ALLOC="$alloc" NTFS="$is_ntfs" awk -F'\t' '
    BEGIN { while ((getline l < ENVIRON["ALLOC"]) > 0) a[l] = 1; ntfs = ENVIRON["NTFS"] + 0 }
    $1 ~ /^r\/r / { split($1, f, " "); id = f[2]; sub(/:$/, "", id)
      rec = id; sub(/-.*/, "", rec)
      if (ntfs && ($2 ~ /^\$/ || $2 ~ /:/)) next
      if (!ntfs && $2 ~ /^\$(VOLUME_GUID|ALLOC_BITMAP|UPCASE_TABLE|MBR|FAT[12]|OrphanFiles)$/) next
      chk = (ntfs && !(rec in a)) ? 1 : 0
      if (NF > 2) { if (!seen[rec "\t?"]++) print id "\t?/entry " rec "\t" chk; next }
      if (seen[rec "\t" $2]++) next
      print id "\t" $2 "\t" chk }' "$listed")
  while read -r i; do
    out="$(istat "${TSK_O[@]}" "$img" "$i" 2>/dev/null)" || continue
    grep '^Allocated' <<<"$out" >/dev/null || continue
    # ext: only regular files with links (the mode string starts with the type, r for a file)
    if [[ $FS_KIND == ext ]] && ! grep -E '^mode: r' <<<"$out" >/dev/null; then continue; fi
    name="$(awk -F': ' '/^Name:/ {print $2; exit}' <<<"$out")"
    printf '%s\t?/%s\n' "$i" "${name:-entry $i}"
  done < <(comm -23 "$alloc" \
    <(awk '{split($2, a, "-"); sub(/:$/, "", a[1]); print a[1]}' "$listed" | sort -u))
}
# Where the data of a file lies (MFT entry REC). The first line is
# "SIZE INITIALISED KIND MTIME_UTC"; then the pieces in order, "VCN LCN LENGTH" in clusters (LCN
# "-" is a sparse piece: zeros). KIND: resident — data inside the MFT entry; simple — one data
# attribute; packed — compressed or encrypted (only through icat); split — pieces in several MFT
# entries; broken — pieces do not add up or do not cover the whole file (then the file counts as
# incomplete).
# The piece list of a heavily fragmented file does not fit in one MFT entry and continues in
# others; $ATTRIBUTE_LIST of the base entry says which entry holds which range (from which VCN).
# The Sleuth Kit 4.12 stitches such files together wrongly: a piece from the base entry goes to a
# separate attribute and a filler stands in its place (icat then returns zeros there at the right
# size); in some files the pieces of an entry are shifted by thousands of clusters, in one the tail
# is missing (most of a multi-gigabyte file); size and initialised size can be wrong too. So the TSK stitching is not
# used: every piece is taken from its own entry (istat of that entry) and only within the range of
# that entry according to the attribute list; sizes come from the entry where VCN 0 starts.
file_map_ntfs() {
  local rec=$1 base ext e
  base="$(istat -r -z UTC "${TSK_O[@]}" "$img" "$rec" 2>/dev/null)" || return 1
  ext="$(awk -v r="$rec" '/^Type: 128-[0-9]+[ \t]+MFT Entry: / && $5 != r {print $5}' <<<"$base" | sort -un)"
  {
    printf '%s\n' "$base"
    for e in $ext; do istat -r "${TSK_O[@]}" "$img" "$e" 2>/dev/null || true; done
  } | awk -v multi="${ext:+1}" '
    /^MFT Entry Header Values:/ { n++; next }
    /^Entry:/ { r = $2; next }
    n == 1 && /^File Modified:/ && mt == "" { sub(/^File Modified:[ \t]*/, ""); sub(/ \(UTC\)$/, ""); mt = $0; next }
    # Attribute list: "Type: 128-ID  MFT Entry: ENTRY  VCN: START".
    n == 1 && /^Type: 128-[0-9]+[ \t]+MFT Entry: / { m++; lid[m] = $2; lrec[m] = $5; lv[m] = $7; next }
    /^Type: / { data = ($2 == "$DATA" && $5 == "N/A"); vcn = 0; first = 1
      if (!data) next
      sz = ""; isz = ""
      for (i = 1; i <= NF; i++) { if ($i == "size:") sz = $(i + 1); if ($i == "init_size:") isz = $(i + 1) }
      if (/Compressed|Encrypted/) packed = 1
      if (n == 1 && !/Non-Resident/) { resident = 1; size = sz; init = sz }
      if (!multi) { lo = 0; hi = -1; next }
      # The range of this entry by the list: [lo, hi); an attribute that is not in the list (a
      # TSK stitch) does not count.
      id = $3; gsub(/[()]/, "", id); lo = -1; hi = -1
      for (i = 1; i <= m; i++) if (lid[i] == id && lrec[i] == r) lo = lv[i]
      if (lo < 0) { data = 0; next }
      for (i = 1; i <= m; i++) if (lv[i] > lo && (hi < 0 || lv[i] < hi)) hi = lv[i]
      if (lo == 0) { size = sz; init = isz }
      next }
    data && /Starting address:/ { gsub(/,/, "")
      # Without a list the size comes from the attribute that starts at VCN 0.
      if (!multi && n == 1 && first && $6 != "Filler" && size == "") { size = sz; init = isz }
      first = 0
      if ($6 == "Filler") { vcn += $5; next }
      if (!multi || (vcn >= lo && (hi < 0 || vcn + $5 <= hi))) print vcn, ($6 == "Sparse" ? "-" : $3), $5
      vcn += $5 }
    END { kind = resident ? "resident" : multi ? (packed ? "broken" : "split") : (packed ? "packed" : "simple")
      print "M", (size == "" ? "-" : size), (init == "" ? 0 : init), kind, mt }' |
    file_map_normalize
}
# The last stage of file_map: sorts the pieces ("VCN LCN LENGTH" lines after the "M SIZE INIT KIND MTIME"
# line), merges neighbours, and makes the file "broken" if they leave a hole or do not reach the size.
file_map_normalize() {
  sort -n | uniq | awk -v cs="$CLUSTER" '

      BEGIN { pos = 0 }
      $1 == "M" { size = $2; init = $3; kind = $4; mt = $0; sub(/^M [^ ]* [^ ]* [^ ]* ?/, "", mt); next }
      { if ($1 != pos) bad = 1
        pos = $1 + $3
        if (k && $2 != "-" && rl[k] != "-" && rl[k] + rn[k] == $2) { rn[k] += $3; next }
        k++; rv[k] = $1; rl[k] = $2; rn[k] = $3 }
      END { if (size == "-") { size = 0; bad = 1 }
        if (kind != "resident" && (bad || pos * cs < size)) kind = "broken"
        print size, init, kind, mt
        for (i = 1; i <= k; i++) print rv[i], rl[i], rn[i] }'
}
# ext and FAT/exFAT: `istat -r` lists the runs of the data as "Starting address: N, length: M" in
# blocks (sectors for FAT), with "Filler" for a hole before the first run and "Sparse" for holes
# between and after; both are zeros. A file whose data lies inside the inode (ext inline data) is
# resident. Same output as file_map_ntfs.
file_map_blocks() {
  istat -r -z UTC "${TSK_O[@]}" "$img" "$1" 2>/dev/null | awk '
    BEGIN { vcn = 0 }
    /^[Ss]ize: / && size == "" { size = $2 }
    /^File Modified:/ && mt == "" { sub(/^File Modified:[ \t]*/, ""); sub(/ \(UTC\)$/, ""); mt = $0 }
    /^Written:/ && mt == "" { sub(/^Written:[ \t]*/, ""); sub(/ \(UTC\)$/, ""); mt = $0 }
    /^Flags:.*Inline Data/ { inline = 1 }
    /Starting address:/ { gsub(/,/, ""); print vcn, ($6 == "Filler" || $6 == "Sparse" ? "-" : $3), $5; vcn += $5 }
    END { print "M", (size == "" ? "-" : size), (size == "" ? 0 : size), (inline ? "resident" : "simple"), mt }' |
    file_map_normalize
}
file_map() {
  case $FS_KIND in
    ext | fat) file_map_blocks "$1" ;;
    *) file_map_ntfs "$1" ;;
  esac
}
# Ranges "START END" from files, ascending; overlapping and adjacent ones merged.
merge_ranges() {
  sort -n "$@" | awk '{ if (n && $1 <= e) { if ($2 > e) e = $2 } else { if (n) print s, e; s = $1; e = $2; n = 1 } }
                      END { if (n) print s, e }'
}
# Classifies the files of tsk_files (stdin) against the ranges RANGES (bytes), one line per file:
# "STATE<TAB>ID<TAB>SIZE<TAB>MTIME_UTC<TAB>PATH<TAB>BYTES_IN_RANGES". The state is intact (data
# entirely outside the ranges), damaged (touches them) or unknown (the entry cannot be parsed or
# its pieces do not add up — better to download again).
# Paths and keys go to awk through the environment: awk -v interprets backslashes in values.
classify() {
  local ranges="$TMPD/classify-ranges.txt" id path fmap
  merge_ranges "$1" >"$ranges"
  while IFS=$'\t' read -r id path; do
    if ! fmap="$(file_map "${id%%-*}")"; then
      printf 'unknown\t%s\t\t\t%s\t\n' "$id" "$path"
      continue
    fi
    CS="$CLUSTER" OFF="$FS_OFFSET" RANGES="$ranges" FID="$id" FPATH="$path" awk '
      # The first range that ends after B (ranges ascend and do not overlap).
      function after(b, lo, hi, mid) { lo = 1; hi = n + 1
        while (lo < hi) { mid = int((lo + hi) / 2); if (re[mid] > b) hi = mid; else lo = mid + 1 }
        return lo }
      BEGIN { cs = ENVIRON["CS"] + 0; off = ENVIRON["OFF"] + 0; path = ENVIRON["FPATH"]; id = ENVIRON["FID"]
        while ((getline line < ENVIRON["RANGES"]) > 0) { split(line, r, " "); n++; rs[n] = r[1] + 0; re[n] = r[2] + 0 } }
      NR == 1 { size = $1; kind = $3; mt = $0; sub(/^[^ ]* [^ ]* [^ ]* ?/, "", mt); next }
      $2 != "-" { b0 = off + $2 * cs; b1 = off + ($2 + $3) * cs
        for (i = after(b0); i <= n && rs[i] < b1; i++) {
          lo = (b0 > rs[i] ? b0 : rs[i]); hi = (b1 < re[i] ? b1 : re[i]); miss += hi - lo } }
      END { st = kind == "broken" ? "unknown" : (miss > 0 ? "damaged" : "intact"); if (path ~ /^\?\//) st = "unknown"
        printf "%s\t%s\t%s\t%s\t%s\t%.0f\n", st, id, size, mt, path, miss }' <<<"$fmap"
  done
}
# The contents of a file by the file_map result, to stdout: pieces from the image in order, sparse
# ones as zeros, zeros from the initialised size to the size, as NTFS returns them. Data inside the
# MFT entry and compressed data go through icat (ID is the attribute for icat).
file_stream() {
  local fmap=$1 id=$2 size init kind s n
  read -r size init kind _ <<<"$fmap"
  if [[ $kind != simple && $kind != split ]]; then
    icat "${TSK_O[@]}" "$img" "$id"
    return
  fi
  ((init <= size)) || init=$size
  while read -r s n; do
    if [[ $s == - ]]; then
      head -c "$n" /dev/zero
    else
      dd if="$img" bs=1M iflag=skip_bytes,count_bytes skip="$s" count="$n" status=none
    fi
  done < <(sed 1d <<<"$fmap" | awk -v cs="$CLUSTER" -v off="$FS_OFFSET" -v init="$init" '
    { n = $3 * cs; if (got + n > init) n = init - got; if (n <= 0) exit
      if ($2 == "-") printf "- %.0f\n", n; else printf "%.0f %.0f\n", off + $2 * cs, n
      got += n }')
  head -c "$((size - init))" /dev/zero
}

# --- Extraction ----------------------------------------------------------------------------------

# Owner of extracted files: --owner, else the user who ran sudo, else root. Files are written as
# that user (runuser), so a setgid directory passes its group on.
setup_owner() {
  command -v python3 >/dev/null || die "extracting safely needs Python 3"
  local user group=""
  RUN_AS=()
  if [[ -n $owner ]]; then
    user="${owner%%:*}"
    [[ $owner != *:* ]] || group="${owner#*:}"
  elif [[ -n ${SUDO_USER:-} ]] && ((EUID == 0)); then
    user=$SUDO_USER
  else
    user="$(id -un)"
  fi
  id -u "$user" >/dev/null 2>&1 || die "--owner: no such user: $user"
  [[ -z $group ]] || getent group "$group" >/dev/null || die "--owner: no such group: $group"
  if [[ $user != "$(id -un)" ]]; then
    ((EUID == 0)) || die "extracting as another user ($user) needs root"
    RUN_AS=(runuser -u "$user")
    [[ -z $group ]] || RUN_AS+=(-g "$group")
    RUN_AS+=(--)
  fi
  "${RUN_AS[@]}" test -w "$extract_to" || die "$extract_to is not writable for $user"
}
# Where a file of the volume goes: the first --map whose source matches, otherwise the same path
# below --extract-to. Prints nothing if --include/--map filter the file out.
dest_for() {
  local path=$1 m inc
  [[ $path != *"/../"* && $path != "../"* && $path != "?/"* ]] || return 0 # "?/" rows are unknown entries
  for m in "${maps[@]}"; do
    local src="${m%%:*}" dst="${m#*:}"
    if [[ $path == "$src/"* ]]; then
      printf '%s/%s%s' "$extract_to" "${dst:+$dst/}" "${path#"$src/"}"
      return 0
    elif [[ $path == "$src" ]]; then
      printf '%s/%s%s' "$extract_to" "${dst:+$dst/}" "${path##*/}"
      return 0
    fi
  done
  if ((${#includes[@]} + ${#maps[@]})); then
    for inc in "${includes[@]}"; do
      if [[ $path == "$inc" || $path == "$inc/"* ]]; then
        printf '%s/%s' "$extract_to" "$path"
        return 0
      fi
    done
    return 0
  fi
  printf '%s/%s' "$extract_to" "$path"
}
# The helper opens every directory relative to an already-open directory, never follows symbolic
# links, and publishes a private temporary file atomically. It runs as the requested file owner.
# Keep it in the script so installation still consists of one file.
safe_extract_init() {
  SAFE_EXTRACT_CODE="$(cat <<'PYCODE'
import ctypes, errno, hashlib, os, secrets, stat, sys

mode, root, rel, filemode, dirmode, epoch, expected, overwrite, verify = sys.argv[1:]
parts = rel.split('/')
if not parts or any(p in ('', '.', '..') for p in parts):
    sys.exit('unsafe extraction path: ' + rel)
flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
fd = None
tmp = None
tmpfd = None
try:
    fd = os.open(root, flags)
    for part in parts[:-1]:
        try:
            child = os.open(part, flags, dir_fd=fd)
        except FileNotFoundError:
            if mode == 'inspect':
                print('missing')
                sys.exit(0)
            try:
                os.mkdir(part, int(dirmode, 8), dir_fd=fd)
                child = os.open(part, flags, dir_fd=fd)
                inherited = os.fstat(child).st_mode & stat.S_ISGID
                os.fchmod(child, int(dirmode, 8) | inherited)
            except FileExistsError:
                child = os.open(part, flags, dir_fd=fd)
        os.close(fd)
        fd = child
    name = parts[-1]
    if mode == 'inspect':
        try:
            source = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        except FileNotFoundError:
            print('missing')
            sys.exit(0)
        try:
            info = os.fstat(source)
            if not stat.S_ISREG(info.st_mode):
                sys.exit('destination is not a regular file: ' + rel)
            digest = '-'
            if verify == '1':
                h = hashlib.sha256()
                while True:
                    chunk = os.read(source, 1024 * 1024)
                    if not chunk:
                        break
                    h.update(chunk)
                digest = h.hexdigest()
            print('file', info.st_size, info.st_mtime_ns // 1000000000, digest)
        finally:
            os.close(source)
        sys.exit(0)
    # An exclusive, unpredictable name avoids collisions with existing .part files and links.
    while True:
        candidate = '.lastread-' + secrets.token_hex(16) + '.part'
        try:
            os.mkdir(candidate, 0o700, dir_fd=fd)
            tmp = candidate
            break
        except FileExistsError:
            continue
    tmpfd = os.open(tmp, flags, dir_fd=fd)
    tmpstat = os.fstat(tmpfd)
    if tmpstat.st_uid != os.geteuid() or tmpstat.st_mode & 0o022:
        sys.exit('temporary directory is not safely owned and protected: ' + rel)
    out = os.open('data', os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=tmpfd)
    h = hashlib.sha256()
    total = 0
    try:
        while True:
            chunk = sys.stdin.buffer.read(1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            h.update(chunk)
            view = memoryview(chunk)
            while view:
                written = os.write(out, view)
                if not written:
                    raise OSError('short write')
                view = view[written:]
            sys.stdout.buffer.write(chunk)
        sys.stdout.buffer.flush()
        if total != int(expected):
            sys.exit('stream size does not match the image: ' + rel)
        os.fchmod(out, int(filemode, 8))
        seconds, _, nanos = epoch.partition(':')
        timestamp_ns = int(seconds) * 1000000000 + int(nanos or 0)
        os.utime(out, ns=(timestamp_ns, timestamp_ns))
        if verify == '1':
            os.fsync(out)
            if hasattr(os, 'posix_fadvise'):
                try:
                    os.posix_fadvise(out, 0, 0, os.POSIX_FADV_DONTNEED)
                except OSError:
                    pass
            os.lseek(out, 0, os.SEEK_SET)
            check = hashlib.sha256()
            while True:
                chunk = os.read(out, 1024 * 1024)
                if not chunk:
                    break
                check.update(chunk)
            if check.digest() != h.digest():
                sys.exit('VERIFICATION FAILED: ' + rel)
            os.write(3, (h.hexdigest() + '\n').encode())
    finally:
        os.close(out)
    if overwrite == '1':
        # Never follow or replace a symlink or a non-regular destination, even with --overwrite.
        try:
            info = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if not stat.S_ISREG(info.st_mode):
                sys.exit('destination is not a regular file: ' + rel)
        except FileNotFoundError:
            pass
        os.replace('data', name, src_dir_fd=tmpfd, dst_dir_fd=fd)
    else:
        # renameat2(NOREPLACE) works on FAT as well as Unix filesystems and is atomic.
        # Older kernels/libcs can fall back to link(), which also refuses an existing name.
        rename = getattr(ctypes.CDLL(None, use_errno=True), 'renameat2', None)
        unsupported = True
        if rename is not None:
            rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
            rename.restype = ctypes.c_int
            if rename(tmpfd, b'data', fd, os.fsencode(name), 1) == 0:  # RENAME_NOREPLACE
                unsupported = False
            else:
                error = ctypes.get_errno()
                if error not in (errno.ENOSYS, errno.EINVAL, errno.EOPNOTSUPP):
                    raise OSError(error, os.strerror(error), rel)
        if unsupported:
            os.link('data', name, src_dir_fd=tmpfd, dst_dir_fd=fd, follow_symlinks=False)
            os.unlink('data', dir_fd=tmpfd)
except OSError as exc:
    sys.exit('safe extraction refused ' + rel + ': ' + str(exc))
finally:
    if tmpfd is not None:
        try:
            os.unlink('data', dir_fd=tmpfd)
        except FileNotFoundError:
            pass
        os.close(tmpfd)
    if tmp is not None and fd is not None:
        try:
            os.rmdir(tmp, dir_fd=fd)
        except FileNotFoundError:
            pass
    if fd is not None:
        os.close(fd)
PYCODE
)"
}
safe_extract() {
  "${RUN_AS[@]}" python3 -c "$SAFE_EXTRACT_CODE" "$1" "$extract_to" "$2" "$file_mode" "$dir_mode" "${3:-0}" "${4:-0}" "$overwrite" "$verify"
}
check_suspect() {
  if [[ -n $SUSPECT_RE ]]; then grep -c -aP "$SUSPECT_RE"; else cat >/dev/null; fi
}
# Propagate read and write errors; grep's status 1 means only that no suspicious bytes matched.
write_stream() (
  local fmap=$1 id=$2 rel=$3 epoch=$4 size=$5
  local -a statuses
  set +e
  file_stream "$fmap" "$id" | safe_extract write "$rel" "$epoch" "$size" 3>"$STREAM_SHA" | check_suspect
  statuses=("${PIPESTATUS[@]}")
  ((statuses[0] == 0 && statuses[1] == 0 && statuses[2] < 2))
)
manifest_add() { printf '%s  %s\n' "$1" "$2" >>"$MANIFEST"; }
extract_files() {
  local tsv=$1 only_intact=$2 state id size mt path dst epoch nanos fmap kind suspect rel got existing ex_kind ex_size ex_time ex_hash want
  local copied=0 skipped=0 verified=0 suspicious="$logs/suspicious-files.txt"
  command -v python3 >/dev/null || die "extracting safely needs Python 3"
  safe_extract_init
  [[ -n $STREAM_SHA ]] || STREAM_SHA="$TMPD/stream.sha"
  touch "$suspicious"
  while IFS=$'\t' read -r state id size mt path _; do
    ((!only_intact)) || [[ $state == intact ]] || continue
    [[ -n $size && -n $mt ]] || continue
    dst="$(dest_for "$path")"
    [[ -n $dst ]] || continue
    read -r epoch nanos < <(date -d "$mt UTC" '+%s %N')
    rel="${dst#"$extract_to"/}"
    existing="$(safe_extract inspect "$rel")" || die "cannot safely inspect destination: $rel"
    read -r ex_kind ex_size ex_time ex_hash <<<"$existing"
    if [[ $ex_kind == file ]]; then
      if [[ $ex_size == "$size" && $ex_time == "$epoch" ]]; then
        if ((!verify)); then
          skipped=$((skipped + 1))
          continue
        fi
        fmap="$(file_map "${id%%-*}")" || die "the entry ${id%%-*} of the file system is unreadable: $path"
        want="$(file_stream "$fmap" "$id" | sha256sum | cut -d' ' -f1)" || die "cannot read image data for $path"
        if [[ $want == "$ex_hash" ]]; then
          manifest_add "$want" "$rel"
          skipped=$((skipped + 1))
          continue
        fi
      fi
      ((overwrite)) || die "destination already exists: $rel; use --overwrite to replace it"
      note "  replacing existing file: $rel"
    fi
    fmap="$(file_map "${id%%-*}")" || die "the entry ${id%%-*} of the file system is unreadable: $path"
    read -r _ _ kind _ <<<"$fmap"
    if [[ $kind == broken ]]; then
      note "  skipped (the pieces of the file do not add up in the file system — download again): $path"
      continue
    fi
    log "  → $path ($(numfmt --to=si "$size")B)"
    suspect="$(write_stream "$fmap" "$id" "$rel" "$epoch:$nanos" "$size")" || die "failed to extract $path safely"
    if ((verify)); then
      got="$(cat "$STREAM_SHA")"
      [[ -n $got ]] || die "verification did not produce a hash for $path"
      manifest_add "$got" "$rel"
      verified=$((verified + 1))
    fi
    if ((${suspect:-0})); then
      note "  suspicious data inside (garbage from the disk or a long run of zeros) — better download again"
      printf '%s\n' "$path" >>"$suspicious"
    fi
    copied=$((copied + 1))
  done <"$tsv"
  sort -u -o "$suspicious" "$suspicious"
  note "extracted files: $copied, already in place: $skipped"
  if ((verify)); then
    note "verified by SHA-256: $verified new files (manifest: $MANIFEST), failed: 0"
  fi
  [[ ! -s $suspicious ]] || note "with suspicious data ($(wc -l <"$suspicious")) — download again: $suspicious"
}
report() {
  local s e _ damaged="$logs/damaged-files.txt" ranges="$logs/report-ranges.txt"
  note "summary by the map:"
  summary
  unread_ranges "-" >"$ranges"
  if zones_exist && zones_abandoned; then
    note "abandoned zones: $(zones_text)"
    while read -r s e _; do echo "$s $e"; done <"$zones" >>"$ranges"
  fi
  image_prepare
  if [[ $FS_STATE != ok ]]; then
    note "unreadable byte ranges: $ranges"
    return 0
  fi
  tsk_files | classify "$ranges" >"$logs/files.tsv"
  awk -F'\t' '$1 != "intact" {print $5}' "$logs/files.tsv" | sort >"$damaged"
  note "files in the image: $(wc -l <"$logs/files.tsv")"
  if [[ -s $damaged ]]; then
    note "damaged files ($(wc -l <"$damaged")) — get them again: $damaged"
    sed 's/^/  /' "$damaged"
  else
    note "the unreadable areas touched no file"
  fi
}
extract() {
  if [[ ! -f $logs/files.tsv ]]; then
    report
    [[ -f $logs/files.tsv ]] || return 0
  fi
  extract_files "$logs/files.tsv" "$((!extract_damaged))"
}
# Without the disk: what is already rescued whole and what is missing; with --extract, extract the
# intact files.
inventory_run() {
  local ranges="$logs/inventory-ranges.txt" tsv="$logs/inventory.tsv" src pair
  unread_ranges "?*/-" >"$ranges"
  image_prepare
  [[ $FS_STATE == ok ]] || die "no file level for this image (see above)"
  tsk_files | classify "$ranges" >"$tsv"
  awk -F'\t' '$1 == "intact" {print $5}' "$tsv" >"$logs/inventory-intact.txt"
  awk -F'\t' '$1 != "intact" {print $5}' "$tsv" >"$logs/inventory-incomplete.txt"
  note "files in the image: $(wc -l <"$tsv"); rescued whole: $(wc -l <"$logs/inventory-intact.txt"), incomplete: $(wc -l <"$logs/inventory-incomplete.txt")"
  if ((${#includes[@]} + ${#maps[@]})); then
    for pair in "${includes[@]}" "${maps[@]}"; do
      src="${pair%%:*}/"
      note "  $src: whole $(grep -c -F -- "$src" "$logs/inventory-intact.txt" || true), incomplete $(grep -c -F -- "$src" "$logs/inventory-incomplete.txt" || true)"
    done
  else
    # per top-level directory (files in the root are counted under "/")
    { awk '{ n = index($0, "/"); print (n ? substr($0, 1, n - 1) : "/") "\twhole" }' "$logs/inventory-intact.txt"
      awk '{ n = index($0, "/"); print (n ? substr($0, 1, n - 1) : "/") "\tincomplete" }' "$logs/inventory-incomplete.txt"
    } | awk -F'\t' '{ c[$1 "\t" $2]++; d[$1] = 1 }
        END { for (k in d) printf "  %s/: whole %d, incomplete %d\n", k, c[k "\twhole"], c[k "\tincomplete"] }' | sort | head -25 |
      while IFS= read -r line; do note "$line"; done
  fi
  note "lists: $logs/inventory-intact.txt, $logs/inventory-incomplete.txt"
  if ((extract)); then extract_files "$tsv" 1; fi
}

# --- Garbage in the image ----------------------------------------------------------------------

# The unread ranges of the map of the given block types, plus what the garbage check found
# (garbage-ranges.txt): files that touch either are damaged.
unread_ranges() {
  { map_ranges "$1"; [[ ! -s $logs/garbage-ranges.txt ]] || cat "$logs/garbage-ranges.txt"; } | merge_ranges /dev/stdin
}
# Sectors of the image where the garbage pattern matches, as merged "START END" ranges.
scan_garbage() {
  LC_ALL=C grep -aboP -- "$GARBAGE_RE" "$img" 2>/dev/null | cut -d: -f1 |
    awk -v ss="$SECTOR" '$1 ~ /^[0-9]+$/ { s = int($1 / ss) * ss; print s, s + ss }' | merge_ranges /dev/stdin || true
}
# mark_map_ranges RANGES: the finished (+) parts of the map inside the ranges become bad sectors (-).
mark_map_ranges() {
  local a len t line
  {
    awk '/^#/ { print; next } ++n == 1 { print; next } { exit }' "$map"
    RANGES="$1" awk '
      function num(s,   i, c, v) {
        if (s !~ /^0[xX]/) return s + 0
        v = 0; s = tolower(substr(s, 3))
        for (i = 1; i <= length(s); i++) { c = index("0123456789abcdef", substr(s, i, 1)) - 1; v = v * 16 + c }
        return v }
      function emit(a, b, t) {
        if (have && pt == t && pe == a) { pe = b } else { flush(); ps = a; pe = b; pt = t; have = 1 } }
      function flush() { if (have) printf "%.0f %.0f %s\n", ps, pe - ps, pt }
      BEGIN { while ((getline l < ENVIRON["RANGES"]) > 0) { split(l, r, " "); n++; rs[n] = r[1] + 0; re[n] = r[2] + 0 } }
      /^#/ { next }
      ++line == 1 { next }
      { pos = num($1); end = pos + num($2); st = $3
        if (st != "+") { emit(pos, end, st); next }
        cur = pos
        for (i = 1; i <= n && cur < end; i++) {
          if (re[i] <= cur) continue
          if (rs[i] >= end) break
          if (rs[i] > cur) emit(cur, rs[i], "+")
          a = (rs[i] > cur ? rs[i] : cur); b = (re[i] < end ? re[i] : end)
          emit(a, b, "-"); cur = b }
        if (cur < end) emit(cur, end, "+") }
      END { flush() }' "$map" | while read -r a len t; do printf '0x%X  0x%X  %s\n' "$a" "$len" "$t"; done
  } >"$map.new"
  mv -f "$map.new" "$map"
}
# The phase of --recheck-garbage. First time: scan, mark what looks like garbage as bad sectors so
# that the retry phase reads those sectors again. Second time (after the retry): scan again; what is
# still garbage is kept in garbage-ranges.txt and counts as unreadable for the file level.
garbage_run() {
  local g="$logs/garbage-ranges.txt" new="$TMPD/garbage-new.txt" total count
  CUR_PHASE=garbage
  write_state running
  note "garbage check: scanning the image for the suspect pattern"
  scan_garbage >"$new"
  count="$(wc -l <"$new")"
  total="$(awk '{s += $2 - $1} END {printf "%.0f", s}' "$new")"
  if [[ ! -e $logs/garbage.marked ]]; then
    if ((count == 0)); then
      note "garbage check: nothing found"
      : >"$g"
      touch "$logs/garbage.marked" "$logs/garbage.done"
      return 0
    fi
    note "garbage check: $count places ($(numfmt --to=iec "$total")B) look like garbage: marked as bad sectors, the retry phase reads them again"
    cp "$new" "$logs/garbage-first.txt"
    mark_map_ranges "$new"
    rm -f "$logs/retry.done"
    touch "$logs/garbage.marked"
    return 0
  fi
  cp "$new" "$g"
  note "garbage check: after the new read $count places ($(numfmt --to=iec "$total")B) still look like garbage — counted as unreadable"
  # What the earlier report and extraction decided is out of date now.
  rm -f "${logs:?}/files.tsv" "${logs:?}/report.done" "${logs:?}/extract.done"
  touch "$logs/garbage.done"
  notify phase-done "garbage check finished: $count places still look like garbage"
}

# --- Metadata first -------------------------------------------------------------------------------

# Little-endian integer of LEN bytes at byte OFFSET of the image.
img_le() {
  local -a b
  local v=0 i
  read -ra b < <(od -An -tu1 -v -j "$1" -N "$2" "$img" 2>/dev/null)
  for ((i = ${#b[@]} - 1; i >= 0; i--)); do v=$((v * 256 + b[i])); done
  printf '%s' "$v"
}
# Byte offsets of the partitions of the image (mmls), one per line; fails if there is no table.
mmls_starts() {
  local mm unit s
  mm="$(mmls -b "$SECTOR" "$img" 2>/dev/null)" || return 1
  [[ -n $mm ]] || return 1
  unit="$(sed -n 's/^Units are in \([0-9]*\)-byte sectors.*/\1/p' <<<"$mm")"
  unit=${unit:-512}
  while read -r s; do
    echo $((10#$s * unit))
  done < <(awk '/^[0-9]+:/ && $2 != "Meta" && $2 != "-------" {print $3}' <<<"$mm")
}
# NTFS geometry from the boot sector at byte START of the image: "CLUSTER MFT_BYTE MIRROR_BYTE RECORD"
# (offsets relative to START, sizes in bytes); fails if it is not an NTFS boot sector.
ntfs_geometry() {
  local s=$1 bps spc mft mir cpr cluster rec
  [[ "$(dd if="$img" bs=1 skip=$((s + 3)) count=8 status=none 2>/dev/null)" == "NTFS    " ]] || return 1
  bps="$(img_le $((s + 11)) 2)"
  spc="$(img_le $((s + 13)) 1)"
  mft="$(img_le $((s + 48)) 8)"
  mir="$(img_le $((s + 56)) 8)"
  cpr="$(img_le $((s + 64)) 1)"
  ((spc < 128)) || spc=$((1 << (256 - spc)))
  ((bps >= 512 && bps <= 4096 && spc >= 1)) || return 1
  cluster=$((bps * spc))
  if ((cpr < 128)); then rec=$((cpr * cluster)); else rec=$((1 << (256 - cpr))); fi
  ((rec >= 256 && rec <= 65536)) || return 1
  echo "$cluster $((mft * cluster)) $((mir * cluster)) $rec"
}
# The data runs of the attributes of type TYPE (128 data, 160 index allocation) of MFT entry REC as
# "START END" byte ranges. The attribute is recognised by its number: on an image whose $AttrDef has
# not been read yet, TSK cannot name the types and prints "?".
attr_ranges() {
  istat -r "${TSK_O[@]}" "$img" "$1" 2>/dev/null | awk -v t="$2" -v cs="$CLUSTER" -v off="$FS_OFFSET" '
    /^Type: / { cur = (index($3, "(" t "-") == 1); next }
    cur && /Starting address:/ { gsub(/,/, ""); if ($6 != "Sparse" && $6 != "Filler") printf "%.0f %.0f\n", off + $3 * cs, off + ($3 + $5) * cs }'
}
# The runs of the directory index of a directory (MFT entry REC).
dir_index_ranges() { attr_ranges "$1" 160; }
# meta_rescue LABEL RANGES_FILE: reads those ranges first (the deferred zones stay out).
meta_rescue() {
  [[ -s $2 ]] || return 0
  merge_ranges "$2" >"$2.merged"
  mv -f "$2.merged" "$2"
  note "metadata first: $1 ($(numfmt --to=iec "$(awk '{s += $2 - $1} END {printf "%.0f", s}' "$2")")B)"
  TARGET_RANGES=$2
  PRIORITY_MODE=1
  rescue_ranges
  TARGET_RANGES=""
  PRIORITY_MODE=0
}
meta_pending() {
  local p
  ((meta_first && !no_fs)) || return 1
  tsk_available || return 1
  [[ -f $map ]] || return 0
  has non-tried || return 1
  [[ -e $logs/meta.done ]] || return 0
  for p in "${firsts[@]}"; do
    grep -Fx -- "$p" "$logs/first.done" >/dev/null 2>&1 || return 0
  done
  return 1
}
# The phase that comes before the ordinary copy: what is needed to know the files (the partition
# table, boot sectors, $MFT, directory indexes) is read first, then the data of the --first paths.
# Everything else follows in the ordinary order. Done once (meta.done); new --first paths later.
meta_run() {
  local r="$logs/meta-ranges.txt" st first_ids id pass dirs rec p cluster mft mir recsize
  local -a starts=() newdirs=()
  local -A seen=()
  CUR_PHASE=meta
  write_state running
  if [[ ! -f $map ]]; then printf '# %s\n0x00000000  ?  1\n0x00000000  0x%X  ?\n' "$PROG" "$PART_SIZE" >"$map"; fi
  [[ -f $img ]] || : >"$img"
  if [[ ! -e $logs/meta.done ]]; then
    printf '0 %s\n' "$((PART_SIZE < 1048576 ? PART_SIZE : 1048576))" >"$r"
    meta_rescue "the start of the disk (partition table)" "$r"
    if (($(stat -c %s "$img") < PART_SIZE)); then truncate -s "$PART_SIZE" "$img" || die "cannot extend $img to the size of the device"; fi
    mapfile -t starts < <(mmls_starts || echo 0)
    : >"$r"
    for st in "${starts[@]}"; do printf '%s %s\n' "$st" "$((st + 65536))" >>"$r"; done
    meta_rescue "boot sectors" "$r"
    : >"$r"
    for st in "${starts[@]}"; do
      if read -r cluster mft mir recsize < <(ntfs_geometry "$st"); then
        printf '%s %s\n' "$((st + mft))" "$((st + mft + (recsize * 16 > 1048576 ? recsize * 16 : 1048576)))" >>"$r"
        printf '%s %s\n' "$((st + mir))" "$((st + mir + recsize * 4))" >>"$r"
      fi
    done
    meta_rescue "the start of the MFT" "$r"
    image_prepare
    if [[ $FS_STATE != ok ]]; then
      note "metadata first: no NTFS volume to read first — the ordinary order follows"
      ((${#firsts[@]} == 0)) || printf '%s\n' "${firsts[@]}" >>"$logs/first.done"
      touch "$logs/meta.done"
      return 0
    fi
    if [[ $FS_KIND != ntfs ]]; then
      note "metadata first: only NTFS volumes are read this way (this one is $(fs_type "$FSOUT")) — the ordinary order follows"
      ((${#firsts[@]} == 0)) || printf '%s\n' "${firsts[@]}" >>"$logs/first.done"
      touch "$logs/meta.done"
      return 0
    fi
    # TSK names attribute types and finds directory indexes through $AttrDef: without its data the
    # volume cannot be walked at all. ($Volume and $UpCase are small and TSK reads them too.)
    : >"$r"
    for rec in 3 4 10; do attr_ranges "$rec" 128 >>"$r"; done
    meta_rescue "system files (\$Volume, \$AttrDef, \$UpCase)" "$r"
    file_byte_ranges 0 >"$r"
    if [[ -s $r ]]; then
      meta_rescue "the \$MFT" "$r"
    else
      note "metadata first: the extent of the \$MFT could not be determined"
    fi
    # Directory indexes: each pass lists the directories that can be reached now, reads the indexes of
    # the new ones, and the next pass reaches the directories below them.
    seen[5]=1
    dir_index_ranges 5 >"$r"
    meta_rescue "directory indexes (the root)" "$r"
    for pass in 1 2 3 4 5 6 7 8; do
      dirs="$(fls -r -p -u -D "${TSK_O[@]}" "$img" 2>/dev/null | awk '$1 ~ /^d\/d/ {split($2, a, "-"); print a[1]}' | sort -u)"
      newdirs=()
      for rec in $dirs; do
        [[ -n ${seen[$rec]:-} ]] || {
          seen[$rec]=1
          newdirs+=("$rec")
        }
      done
      ((${#newdirs[@]})) || break
      : >"$r"
      for rec in "${newdirs[@]}"; do dir_index_ranges "$rec" >>"$r"; done
      meta_rescue "directory indexes (pass $pass, ${#newdirs[@]} directories)" "$r"
    done
    touch "$logs/meta.done"
  else
    image_prepare
    if [[ $FS_STATE != ok || $FS_KIND != ntfs ]]; then
      note "metadata first: no NTFS volume, --first has nothing to read"
      ((${#firsts[@]} == 0)) || printf '%s\n' "${firsts[@]}" >>"$logs/first.done"
      return 0
    fi
  fi
  for p in "${firsts[@]}"; do
    grep -Fx -- "$p" "$logs/first.done" >/dev/null 2>&1 && continue
    first_ids="$(tsk_files | PFX="$p" awk -F'\t' '{ pf = ENVIRON["PFX"]; if ($2 == pf || index($2, pf "/") == 1) print $1 }')"
    : >"$r"
    for id in $first_ids; do file_byte_ranges "$id" >>"$r"; done
    if [[ -s $r ]]; then
      meta_rescue "the data of --first $p" "$r"
    else
      note "metadata first: nothing found under --first $p"
    fi
    printf '%s\n' "$p" >>"$logs/first.done"
  done
  note "metadata first: finished — $(status_short)"
}

# --- Targeted recovery -----------------------------------------------------------------------------

# Where the data of a file lies: "START END" (bytes) per piece of file_map.
file_byte_ranges() {
  { file_map "${1%%-*}" || true; } | awk -v cs="$CLUSTER" -v off="$FS_OFFSET" 'NR > 1 && $2 != "-" { printf "%.0f %.0f\n", off + $2 * cs, off + ($2 + $3) * cs }'
}
# The ddrescue domain from the ranges RANGES: they are "+", the rest is outside the domain.
# The ranges of KEEP without the ranges of SUB (files of "START END" lines, ascending, merged).
subtract_ranges() {
  awk 'FNR == NR { zs[++n] = $1; ze[n] = $2; next }
       { s = $1; e = $2
         for (i = 1; i <= n; i++) {
           if (ze[i] <= s) continue
           if (zs[i] >= e) break
           if (zs[i] > s) print s, zs[i]
           if (ze[i] > s) s = ze[i]
           if (s >= e) break }
         if (s < e) print s, e }' "$2" "$1"
}
write_ranges_domain() {
  local pos=0 s e merged="$TMPD/ranges-merged.txt"
  merge_ranges "$1" >"$merged"
  if ((PRIORITY_MODE)) && zones_exist; then
    subtract_ranges "$merged" "$zones" >"$merged.cut"
    mv -f "$merged.cut" "$merged"
  fi
  {
    printf '# %s: ddrescue domain (selected files)\n0x00000000  +  1\n' "$PROG"
    while read -r s e; do
      ((s <= pos)) || printf '0x%X  0x%X  ?\n' "$pos" "$((s - pos))"
      printf '0x%X  0x%X  +\n' "$s" "$((e - s))"
      pos=$e
    done <"$merged"
    ((pos >= PART_SIZE)) || printf '0x%X  0x%X  ?\n' "$pos" "$((PART_SIZE - pos))"
  } >"$domain"
}
# Are there blocks of this kind inside the selected files?
has_in() {
  write_ranges_domain "$TARGET_RANGES"
  ! ddrescuelog -m "$domain" -t "$map" | grep -E "^ *$1: +0 B," >/dev/null
}
# A short caption of a file for the selection window: at most 60 characters.
short_name() {
  (
    LC_ALL=C.UTF-8
    p=$1
    ((${#p} <= 60)) || p="${p:0:28}…${p: -31}"
    printf '%s' "$p"
  )
}
# Selection window: whiptail, or plain questions without it. Everything the person sees goes
# through /dev/tty, stdout is only the answers. ui_checklist TEXT TAG DESCRIPTION [TAG DESCRIPTION...]
# prints the chosen tags one per line; status 1 — cancelled.
ui_checklist() {
  local text=$1 args=() answer tag n=0 lines cols h w
  shift
  if ! command -v whiptail >/dev/null || [[ ${LASTREAD_PLAIN:-0} == 1 ]]; then
    printf '\n%s\n' "$text" >/dev/tty
    while (($#)); do
      printf '  %s — %s\n' "$1" "$2" >/dev/tty
      shift 2
    done
    printf 'Tags separated by spaces: ' >/dev/tty
    read -r answer </dev/tty
    [[ -n $answer ]] || return 1
    for tag in $answer; do printf '%s\n' "$tag"; done
    return 0
  fi
  while (($#)); do
    args+=("$1" "$2" OFF)
    n=$((n + 1))
    shift 2
  done
  lines="$(tput lines 2>/dev/null || echo 24)"
  cols="$(tput cols 2>/dev/null || echo 80)"
  h=$((lines > 34 ? 30 : lines - 4))
  w=$((cols > 104 ? 100 : cols - 4))
  LC_ALL=C.UTF-8 whiptail --backtitle "$PROG — file selection" --title "$PROG" --separate-output \
    --checklist "$text" "$h" "$w" "$((h - 8))" "${args[@]}" 3>&1 1>&2 2>&3 </dev/tty >/dev/tty
}
# Reads only the ranges listed in the file TARGET_RANGES ("START END" lines): copy, scrape and
# retry inside them, under the watchdog, with the recovery of a dropped disk. The body shared by
# targeted recovery and the metadata-first phase.
rescue_ranges() {
  local retried=0 phase rc p before
  while :; do
    if has_in non-tried; then
      phase=copy
    elif has_in non-trimmed || has_in non-scraped; then
      phase=scrape
    elif has_in bad-sector && ((!retried)); then
      phase=retry
    else
      break
    fi
    device_ok || recover_device || die_device
    p="$(temperature)" || p=""
    if [[ -n $p ]] && ((p >= stop)); then wait_cool; fi
    before="$(status_short)"
    rc=0
    run_ddrescue "$phase" || rc=$?
    if ((rc == 11)) || ! device_ok; then
      notify dropped "the disk dropped"
      revert_artifacts
      p="$(hang_position "$RATES")"
      [[ -z $p ]] || zone_hang "$((p))" copy
      [[ "$(status_short)" == "$before" ]] || recoveries=0
      recover_device || die_device
      continue
    fi
    [[ "$(status_short)" == "$before" ]] || recoveries=0
    case $rc in
      0) [[ $phase != retry ]] || retried=1 ;;
      10) wait_cool ;;
      *) die "ddrescue exited with code $rc; logs: $logs" ;;
    esac
  done
}
targeted_run() {
  local cand="$logs/target-candidates.tsv" sel="$logs/target-selected.tsv" unread="$logs/target-unread.txt"
  local ranges="$logs/target-ranges.txt" n state id size path miss tag pat choice
  local -a items=() tags=()
  image_prepare
  [[ $FS_STATE == ok ]] || die "no file level for this image (see above)"
  unread_ranges "?*/-" >"$unread"
  # Candidates are the incomplete files. With an inventory only its incomplete files are rechecked
  # (fast), without one all files of the volume (minutes).
  note "looking for incomplete files…"
  if [[ -f $logs/inventory.tsv ]]; then
    awk -F'\t' '$1 != "intact" {print $2 "\t" $5}' "$logs/inventory.tsv"
  else
    tsk_files
  fi | classify "$unread" | awk -F'\t' '$1 == "damaged"' >"$cand"
  [[ -s $cand ]] || {
    note "no incomplete files — nothing to recover selectively"
    return 0
  }
  if ((${#file_patterns[@]})); then
    : >"$sel"
    for pat in "${file_patterns[@]}"; do PAT="$pat" awk -F'\t' 'index($5, ENVIRON["PAT"])' "$cand" >>"$sel"; done
    sort -u -o "$sel" "$sel"
  else
    n=0
    while IFS=$'\t' read -r state id size _ path miss; do
      n=$((n + 1))
      items+=("$n" "$(short_name "$path") — $(numfmt --to=si "$size")B, $((miss * 100 / (size > 0 ? size : 1)))% unread")
    done <"$cand"
    choice="$(ui_checklist "Incomplete files: which ones to read from the disk first? Space marks, Enter starts." "${items[@]}")" ||
      die "nothing selected"
    mapfile -t tags <<<"$choice"
    : >"$sel"
    for tag in "${tags[@]}"; do sed -n "${tag}p" "$cand" >>"$sel"; done
  fi
  [[ -s $sel ]] || die "nothing selected (no incomplete file has such a path)"
  note "targeted recovery, files: $(wc -l <"$sel"), unread in them: $(numfmt --to=si "$(awk -F'\t' '{s += $6} END {printf "%.0f", s}' "$sel")")B"
  awk -F'\t' '{print "  " $5}' "$sel"
  : >"$ranges"
  while IFS=$'\t' read -r _ id _; do file_byte_ranges "$id" >>"$ranges"; done <"$sel"
  TARGET_RANGES=$ranges
  rescue_ranges
  TARGET_RANGES=""
  # What the earlier report and extraction decided is out of date now: a normal run does them again.
  rm -f "${logs:?}/files.tsv" "${logs:?}/report.done" "${logs:?}/extract.done"
  unread_ranges "?*/-" >"$unread"
  awk -F'\t' '{print $2 "\t" $5}' "$sel" | classify "$unread" >"$logs/target-result.tsv"
  note "result of targeted recovery:"
  awk -F'\t' '{printf "  %s  %s\n", ($1 == "intact" ? "whole     " : "incomplete"), $5}' "$logs/target-result.tsv"
  if ((extract)); then extract_files "$logs/target-result.tsv" 1; fi
}

# --- Triage ---------------------------------------------------------------------------------------

tri_note() { TRI_NOTES+=("$*"); }
tri_warn() { TRI_WARN+=("$*"); }
tri_red() { TRI_RED+=("$*"); }
# The raw value of an ATA SMART attribute (by id) in a smartctl JSON document; empty if absent.
smart_attr() { jq -r --argjson id "$2" '[.ata_smart_attributes.table[]? | select(.id == $id) | .raw.value][0] // empty' <<<"$1"; }
# Reads a smartctl JSON document (-j -i -H -A): prints the facts, records findings.
triage_smart_json() {
  local j=$1 passed model poh temp realloc pend unc crc rep crit media used spare
  model="$(jq -r '.model_name // empty' <<<"$j")"
  passed="$(jq -r '.smart_status.passed | if . == null then "" else tostring end' <<<"$j")"
  poh="$(jq -r '.power_on_time.hours // empty' <<<"$j")"
  temp="$(jq -r '.temperature.current // empty' <<<"$j")"
  [[ -z $model ]] || log "  model:          $model"
  [[ -z $poh ]] || log "  power-on time:  $poh h"
  [[ -z $temp ]] || log "  temperature:    $temp °C"
  case $passed in
    true) log "  SMART health:   passed" ;;
    false)
      log "  SMART health:   FAILED"
      tri_warn "SMART overall health is FAILED: the disk predicts its own failure — image it now"
      ;;
    *) log "  SMART health:   not reported" ;;
  esac
  realloc="$(smart_attr "$j" 5)"
  rep="$(smart_attr "$j" 187)"
  pend="$(smart_attr "$j" 197)"
  unc="$(smart_attr "$j" 198)"
  crc="$(smart_attr "$j" 199)"
  [[ -z $realloc ]] || log "  reallocated:    $realloc sectors"
  [[ -z $pend ]] || log "  pending:        $pend sectors"
  [[ -z $unc ]] || log "  uncorrectable:  $unc sectors (offline)"
  [[ -z $crc ]] || log "  interface CRC:  $crc errors"
  if [[ $pend =~ ^[0-9]+$ ]] && ((pend > 0)); then tri_warn "$pend sectors are pending (unreadable until rewritten): expect unreadable areas"; fi
  if [[ $unc =~ ^[0-9]+$ ]] && ((unc > 0)); then tri_warn "$unc sectors are offline-uncorrectable: expect unreadable areas"; fi
  if [[ $rep =~ ^[0-9]+$ ]] && ((rep > 0)); then tri_warn "$rep uncorrectable read errors were reported by the disk"; fi
  if [[ $realloc =~ ^[0-9]+$ ]] && ((realloc > 1000)); then
    tri_warn "$realloc reallocated sectors: the surface is heavily worn"
  elif [[ $realloc =~ ^[0-9]+$ ]] && ((realloc > 0)); then
    tri_note "$realloc reallocated sectors"
  fi
  if [[ $crc =~ ^[0-9]+$ ]] && ((crc > 0)); then tri_warn "$crc interface CRC errors: check the cable, the connector or the USB bridge"; fi
  crit="$(jq -r '.nvme_smart_health_information_log.critical_warning // empty' <<<"$j")"
  media="$(jq -r '.nvme_smart_health_information_log.media_errors // empty' <<<"$j")"
  used="$(jq -r '.nvme_smart_health_information_log.percentage_used // empty' <<<"$j")"
  spare="$(jq -r '.nvme_smart_health_information_log.available_spare // empty' <<<"$j")"
  if [[ -n $crit$media$used ]]; then
    log "  NVMe:           critical warning $crit, media errors $media, used $used%, spare $spare%"
    if [[ $crit =~ ^[0-9]+$ ]] && ((crit != 0)); then tri_warn "NVMe critical warning flags are set ($crit)"; fi
    if [[ $media =~ ^[0-9]+$ ]] && ((media > 0)); then tri_warn "NVMe reports $media media errors"; fi
    if [[ $used =~ ^[0-9]+$ ]] && ((used >= 100)); then tri_note "NVMe endurance used: $used%"; fi
  fi
}
# Sample offsets (bytes, multiples of 1 MiB) for a device of SIZE bytes: the start, seven points in
# between, the end.
triage_positions() {
  local size=$1 m=1048576 i pos
  {
    for i in 0 1 2 3 4 5 6 7 8; do
      pos=$((size * i / 8 / m * m))
      ((pos + m <= size)) || continue
      echo "$pos"
    done
    ((size < m)) || echo $(((size - m) / m * m))
  } | sort -n -u
}
# Reads 1 MiB at POS with a limit; a read that does not return in --triage-timeout seconds is
# abandoned (a hung disk may keep it stuck for the kernel's own timeout). Sets TRI_RES (ok, slow,
# error, timeout) and TRI_MS.
triage_read() {
  local pos=$1 t0 t1 pid waited=0 max=$((triage_timeout * 10)) rc=0
  t0="$(date +%s%N)"
  dd if="$dev" of=/dev/null bs=1M count=1 skip=$((pos / 1048576)) iflag=direct status=none 2>/dev/null 8>&- &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if ((waited >= max)); then
      kill -TERM "$pid" 2>/dev/null || true
      disown "$pid" 2>/dev/null || true
      TRI_RES=timeout
      TRI_MS=$((triage_timeout * 1000))
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  wait "$pid" || rc=$?
  t1="$(date +%s%N)"
  TRI_MS=$(((t1 - t0) / 1000000))
  if ((rc != 0)); then TRI_RES=error; elif ((TRI_MS > 1000)); then TRI_RES=slow; else TRI_RES=ok; fi
}
# SMART through smartctl: plain first, then -d sat (a SATA disk behind a USB bridge); the facts
# and findings come from triage_smart_json. Without smartctl or jq, or with no SMART at all, a note.
triage_smart_collect() {
  local out="" type got=0
  SMART_TYPE_FOUND=""
  if ! command -v smartctl >/dev/null || ! command -v jq >/dev/null; then
    tri_note "smartctl or jq is missing: no SMART data (apt install smartmontools jq)"
    return 0
  fi
  local -a types=("${smart_type:-}")
  [[ -n $smart_type ]] || types+=(sat)
  for type in "${types[@]}"; do
    local -a args=()
    [[ -z $type ]] || args=(-d "$type")
    out="$(timeout 30 smartctl -j -i -H -A "${args[@]}" "$whole" 2>/dev/null || true)"
    if jq -e '.smart_status or .ata_smart_attributes or .nvme_smart_health_information_log' <<<"$out" >/dev/null 2>&1; then
      got=1
      SMART_TYPE_FOUND=$type
      break
    fi
  done
  if ((got)); then
    triage_smart_json "$out"
  else
    tri_note "no SMART data from this device (a virtual disk, or a USB bridge that hides it: try --smart-type)"
  fi
}
# Kernel messages about the disk: link problems of its ATA port and I/O errors. Prints the lines
# and records findings; silent if the log cannot be read.
triage_dmesg() {
  local port="" resets errs text
  text="$(dmesg 2>/dev/null)" || return 0
  [[ -n $text ]] || return 0
  port="$(readlink -f "/sys/block/$parent/device" 2>/dev/null | sed -n 's|.*/ata\([0-9][0-9]*\)/.*|\1|p' | head -1)"
  if [[ -n $port ]]; then
    resets="$(grep -E "ata$port(\\.[0-9]+)?: " <<<"$text" | grep -Ec 'hard resetting link|COMRESET failed|failed command|SError|link is slow' || true)"
    log "  kernel log:     $resets link/command problems on ata$port"
    if ((resets >= 3)); then
      tri_warn "the kernel logged $resets link or command problems on ata$port: the link is unstable (try a slower link: libata.force=$port:1.5Gbps, see the README)"
    fi
  fi
  errs="$(grep -Ec "I/O error, dev $parent\\b" <<<"$text" || true)"
  if ((errs > 0)); then
    log "  kernel log:     $errs I/O errors for $parent"
    tri_warn "the kernel logged $errs I/O errors for $parent"
  fi
}
# --triage SOURCE: a short, read-only check with a verdict.
triage_run() {
  local c
  for c in lsblk blockdev dd; do command -v "$c" >/dev/null || die "missing command: $c"; done
  ((EUID == 0)) || die "root is needed to read the device: run through sudo"
  [[ -n $source_arg ]] || die "no source: give a device (see --help)"
  [[ -b $source_arg ]] || die "no block device $source_arg"
  resolve_device
  PART_SIZE="$(blockdev --getsize64 "$dev")"
  log "$PROG triage of $source_arg"
  log "  device:         $dev (disk $whole), $(gb "$PART_SIZE"), sector $SECTOR, ${TRANSPORT:-no transport}"
  local rota mounted
  rota="$(lsblk -dno ROTA "$whole" 2>/dev/null | head -1 | tr -d ' ')"
  [[ -z $rota ]] || log "  kind:           $([[ $rota == 1 ]] && echo 'rotating disk' || echo 'no rotating platters (SSD, flash, virtual)')"
  mounted="$( (findmnt -n -o TARGET -S "$dev" || true; lsblk -nr -o MOUNTPOINTS "$dev" 2>/dev/null || true) | awk 'NF' | sort -u | paste -sd ' ')" || mounted=""
  if [[ -n $mounted ]]; then
    log "  mounted:        $mounted"
    tri_warn "the source is mounted ($mounted): unmount it (or do not use it) before rescuing"
  fi
  ((PART_SIZE > 0)) || tri_red "the device reports no size"
  triage_smart_collect
  triage_dmesg
  # sample reads
  log "  sample reads (1 MiB each, at most ${triage_timeout} s per read):"
  local pos fails=0 slow=0 bad=0 sampled=0 ms rate
  while read -r pos; do
    triage_read "$pos"
    sampled=$((sampled + 1))
    ms=$TRI_MS
    rate="$(awk -v ms="$ms" 'BEGIN { if (ms > 0) printf "%.1f MB/s", 1048.576 / ms; else print "-" }')"
    log "    $(printf '%8s' "$(numfmt --to=si "$pos")B"): $(printf '%-7s' "$TRI_RES") ${ms} ms ($rate)"
    case $TRI_RES in
      ok) fails=0 ;;
      slow)
        slow=$((slow + 1))
        fails=0
        ;;
      error | timeout)
        bad=$((bad + 1))
        fails=$((fails + 1))
        ;;
    esac
    if ((fails >= 2)); then
      log "    two failures in a row: not reading any more"
      break
    fi
    if [[ $TRI_RES == timeout ]]; then
      log "    no answer: the disk is hung, not reading any more"
      break
    fi
  done < <(triage_positions "$PART_SIZE")
  ((bad == 0)) || tri_warn "$bad of $sampled sample reads failed or timed out"
  ((slow == 0)) || tri_warn "$slow of $sampled sample reads were slow (more than a second per MiB)"
  if ((sampled > 0 && bad == sampled)) || ((fails >= 2)) || [[ $TRI_RES == timeout ]]; then
    tri_red "the disk does not answer reads (${bad} of ${sampled} sample reads failed or hung)"
  fi
  local verdict=GREEN f
  ((${#TRI_WARN[@]} == 0)) || verdict=YELLOW
  ((${#TRI_RED[@]} == 0)) || verdict=RED
  log ""
  for f in "${TRI_RED[@]}"; do log "  RED:    $f"; done
  for f in "${TRI_WARN[@]}"; do log "  WARN:   $f"; done
  for f in "${TRI_NOTES[@]}"; do log "  note:   $f"; done
  case $verdict in
    RED)
      log "Verdict: RED — the disk barely answers. If the data matters, stop now and consider a data"
      log "recovery lab: every extra minute of running costs data. If you go on anyway, expect hangs and"
      log "power cycles, use /dev/disk/by-id/... and read the README (\"When not to use it\")."
      ;;
    YELLOW)
      log "Verdict: YELLOW — workable, with trouble expected (unreadable areas, slow places or an unstable link)."
      log "That is what $PROG is for; image it soon and do not run anything else on this disk."
      ;;
    *) log "Verdict: GREEN — nothing alarming in this short check. It is a heuristic, not a guarantee." ;;
  esac
  log "Suggested start:"
  local opts=""
  [[ -z $SMART_TYPE_FOUND ]] || opts+=" --smart-type $SMART_TYPE_FOUND"
  ((slow == 0 && bad == 0)) || opts+=" --min-rate 1M --skip-size 1Mi"
  log "  sudo $PROG $source_arg --dir /path/on/another/disk --name NAME$opts"
  [[ $verdict != RED ]] || return 4
}

# --- Status ---------------------------------------------------------------------------------------

# Progress sampling for the rate and the state file: the rescued bytes of the map, a sliding
# window of ten minutes. (The rate log of ddrescue is written only when it exits, so it cannot be
# used while it runs.)
sample_progress() {
  [[ -f $map ]] || return 0
  local now=$SECONDS b
  b="$(map_totals "$map" | sed -n 's/^rescued=\([0-9]*\) .*/\1/p')"
  [[ -n $b ]] || return 0
  RESCUED=$b
  RATE_T+=("$now")
  RATE_B+=("$b")
  while ((${#RATE_T[@]} > 1 && now - RATE_T[0] > 600)); do
    RATE_T=("${RATE_T[@]:1}")
    RATE_B=("${RATE_B[@]:1}")
  done
  if ((${#RATE_T[@]} > 1 && now > RATE_T[0])); then RATE=$(((b - RATE_B[0]) / (now - RATE_T[0]))); else RATE=0; fi
  ((RATE >= 0)) || RATE=0
}
# Bytes per kind of block of a map: "rescued=… non_tried=… non_trimmed=… non_scraped=… bad=…".
map_totals() {
  awk '
    function num(s,   i, c, v) {
      if (s !~ /^0[xX]/) return s + 0
      v = 0; s = tolower(substr(s, 3))
      for (i = 1; i <= length(s); i++) { c = index("0123456789abcdef", substr(s, i, 1)) - 1; v = v * 16 + c }
      return v }
    !/^#/ && ++n > 1 { t[$3] += num($2) }
    END { printf "rescued=%.0f non_tried=%.0f non_trimmed=%.0f non_scraped=%.0f bad=%.0f\n", t["+"], t["?"], t["*"], t["/"], t["-"] }' "$1"
}
# A duration in seconds as "3 h 12 min".
fmt_duration() {
  local sec=$1
  if ((sec >= 86400)); then
    printf '%d d %d h' $((sec / 86400)) $((sec % 86400 / 3600))
  elif ((sec >= 3600)); then
    printf '%d h %d min' $((sec / 3600)) $((sec % 3600 / 60))
  elif ((sec >= 60)); then
    printf '%d min' $((sec / 60))
  else
    printf '%d s' "$sec"
  fi
}
state_value() { sed -n "s/^$1=//p" "$logs/state" 2>/dev/null | head -1; }
# --status: everything comes from the map and the logs; the disk is not touched.
status_run() {
  [[ -f $map ]] || die "no map for \"$name\" in $dir (--dir/--name)"
  PART_SIZE="$(map_size "$map")"
  domain="$TMPD/domain.map" # next_phase writes a domain file; never into the logs of a running rescue
  local totals rescued non_tried non_trimmed non_scraped bad unread
  totals="$(map_totals "$map")"
  rescued="$(sed -n 's/.*rescued=\([0-9]*\).*/\1/p' <<<"$totals")"
  non_tried="$(sed -n 's/.*non_tried=\([0-9]*\).*/\1/p' <<<"$totals")"
  non_trimmed="$(sed -n 's/.*non_trimmed=\([0-9]*\).*/\1/p' <<<"$totals")"
  non_scraped="$(sed -n 's/.*non_scraped=\([0-9]*\).*/\1/p' <<<"$totals")"
  bad="$(sed -n 's/.*bad=\([0-9]*\).*/\1/p' <<<"$totals")"
  unread=$((non_tried + non_trimmed + non_scraped))
  local running=0 st upd age pid rate temp phase_now eta=""
  if [[ -e $dir/.$name.lock ]] && ! flock -n -s "$dir/.$name.lock" true 2>/dev/null; then running=1; fi
  st="$(state_value state)"
  upd="$(state_value updated)"
  pid="$(state_value pid)"
  rate="$(state_value rate)"
  temp="$(state_value temperature)"
  age=""
  [[ $upd =~ ^[0-9]+$ ]] && age=$(($(date +%s) - upd))
  if ((running == 0)) && [[ $st == running || $st == cooling || $st == starting ]]; then st="stopped (the run is gone)"; fi
  [[ -n $st ]] || st="no run recorded"
  # the run's own settings decide whether the metadata-first phase is still ahead of it
  [[ "$(state_value meta)" != 0 ]] || meta_first=0
  phase_now="$(next_phase)"
  if [[ $rate =~ ^[0-9]+$ ]] && ((rate > 0 && running && unread > 0)); then eta=$((unread / rate)); fi
  local -a events=()
  [[ ! -f $LOG ]] || mapfile -t events < <(tail -n 5 "$LOG")
  if ((json)); then
    command -v jq >/dev/null || die "--json needs jq"
    local zjson ejson
    zjson="$( ([[ ! -s $zones ]] || cat "$zones") | jq -Rn '[inputs | split(" ") | select(length >= 4) | {start: (.[0] | tonumber), end: (.[1] | tonumber), direction: .[2], failures: (.[3] | tonumber)}]')"
    ejson="$(printf '%s\n' "${events[@]}" | jq -R . | jq -s .)"
    jq -n --arg name "$name" --arg dir "$dir" --arg image "$img" --arg map "$map" \
      --argjson size "$PART_SIZE" --argjson rescued "$rescued" --argjson non_tried "$non_tried" \
      --argjson non_trimmed "$non_trimmed" --argjson non_scraped "$non_scraped" --argjson bad "$bad" \
      --argjson running "$((running == 1))" --arg state "$st" --arg phase "$phase_now" \
      --argjson pid "$([[ $pid =~ ^[0-9]+$ ]] && echo "$pid" || echo null)" \
      --argjson updated_seconds_ago "$([[ -n $age ]] && echo "$age" || echo null)" \
      --argjson rate "$([[ $rate =~ ^[0-9]+$ ]] && echo "$rate" || echo null)" \
      --argjson eta_seconds "$([[ -n $eta ]] && echo "$eta" || echo null)" \
      --argjson temperature "$([[ $temp =~ ^[0-9]+$ ]] && echo "$temp" || echo null)" \
      --argjson zones "$zjson" --argjson zones_given_up "$(zones_abandoned && echo true || echo false)" \
      --argjson report_done "$([[ -e $logs/report.done ]] && echo true || echo false)" \
      --argjson extract_done "$([[ -e $logs/extract.done ]] && echo true || echo false)" \
      --argjson last_events "$ejson" \
      '{name: $name, dir: $dir, image: $image, map: $map, size: $size, running: ($running == 1), state: $state,
        pid: $pid, updated_seconds_ago: $updated_seconds_ago, next_phase: $phase,
        rescued: $rescued, non_tried: $non_tried, non_trimmed: $non_trimmed, non_scraped: $non_scraped, bad: $bad,
        rescued_percent: (if $size > 0 then (($rescued * 1000 / $size) | floor) / 10 else 0 end),
        rate_bytes_per_second: $rate, eta_seconds: $eta_seconds, temperature: $temperature,
        zones: $zones, zones_given_up: $zones_given_up,
        report_done: $report_done, extract_done: $extract_done, last_events: $last_events}'
    return 0
  fi
  local pct
  pct="$(awk -v r="$rescued" -v s="$PART_SIZE" 'BEGIN { printf "%.1f", (s > 0 ? r * 100 / s : 0) }')"
  log "$PROG status: $name"
  log "  directory:      $dir"
  if ((running)); then
    log "  state:          $st (pid ${pid:-?}${age:+, updated $(fmt_duration "$age") ago})"
  else
    log "  state:          $st"
  fi
  log "  next phase:     $phase_now"
  log "  rescued:        $pct% ($(gb "$rescued") of $(gb "$PART_SIZE"))"
  log "  not read yet:   $(gb "$unread") (not tried $(gb "$non_tried"), not trimmed $(gb "$non_trimmed"), not scraped $(gb "$non_scraped"))"
  log "  unreadable:     $(gb "$bad")"
  if ((running)) && [[ $rate =~ ^[0-9]+$ ]]; then
    if ((rate > 0)); then
      log "  rate:           $(numfmt --to=si "$rate")B/s over the last 10 minutes${eta:+; about $(fmt_duration "$eta") to read what is not read yet (rough)}"
    else
      log "  rate:           none at the moment (paused or waiting)"
    fi
  fi
  [[ -z $temp ]] || log "  temperature:    $temp °C"
  if [[ -s $zones ]]; then
    log "  deferred zones: $(wc -l <"$zones")$(zones_abandoned && printf ' (given up)'): $(zones_text)"
  fi
  log "  report:         $([[ -e $logs/report.done ]] && echo "done" || echo pending)"
  log "  extraction:     $([[ -e $logs/extract.done ]] && echo "done" || echo "not done")"
  if ((${#events[@]})); then
    log "  last events:"
    printf '    %s\n' "${events[@]}"
  fi
}

# --- systemd unit ---------------------------------------------------------------------------------

# A string as one systemd command-line argument: quoted, with \, ", % and $ escaped.
unit_arg() {
  local a=$1
  a=${a//\\/\\\\}
  a=${a//\"/\\\"}
  a=${a//%/%%}
  a=${a//\$/\$\$}
  printf '"%s"' "$a"
}
# Prints a systemd service that runs the current command line (without --print-service). The
# disk dropping and needing a power cycle (exit 3), stuck zones (2) and a stop by systemctl do not
# restart the service; other failures restart it a few times. Enabled, it continues by itself
# after the power cycle.
service_unit() {
  local self a line
  self="$(readlink -f "$0")"
  line="$(unit_arg "$self")"
  for a in "${ORIG_ARGS[@]}"; do
    [[ $a == --print-service ]] || line+=" $(unit_arg "$a")"
  done
  cat <<EOF
# Save as /etc/systemd/system/$PROG-${name:-rescue}.service, then:
#   systemctl daemon-reload && systemctl enable --now $PROG-${name:-rescue}.service
# When the rescue is finished: systemctl disable $PROG-${name:-rescue}.service
[Unit]
Description=$PROG: rescue of ${name:-a disk}
After=local-fs.target
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=$line
Restart=on-failure
RestartSec=120
RestartPreventExitStatus=2 3
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
EOF
}

# --- Main ----------------------------------------------------------------------------------------

cleanup() {
  [[ -z $INHIBIT_PID ]] || kill "$INHIBIT_PID" 2>/dev/null || true
  if [[ -n $DD_PID ]] && kill -0 "$DD_PID" 2>/dev/null; then
    kill -TERM "$DD_PID" 2>/dev/null || true
    wait "$DD_PID" 2>/dev/null || true
  fi
  [[ -z $orig_timeout ]] || echo "$orig_timeout" >"$timeout_file" 2>/dev/null || true
  restore_readonly
  if ((RUN_STARTED)); then
    case $RUN_STATE in
      done | failed | power-cycle | zones-stuck | stopped) ;;
      *) write_state stopped ;;
    esac
  fi
  [[ -z $TMPD ]] || rm -rf "$TMPD"
}

# --- Read-only flag ----------------------------------------------------------------------------

# While rescuing, the source gets the kernel's read-only flag: nothing else on this machine (a
# mount, a stray fsck, a write by mistake) can modify the failing disk. A disk that comes back
# is a new device and gets the flag again. The original value is restored on exit.
set_readonly() {
  ((readonly_flag)) || return 0
  local cur
  cur="$(blockdev --getro "$dev" 2>/dev/null)" || {
    warn "cannot read the read-only flag of $dev"
    return 0
  }
  [[ -n $RO_ORIG ]] || RO_ORIG=$cur
  [[ $cur != 1 ]] || return 0
  if blockdev --setro "$dev" 2>/dev/null; then
    RO_SET=1
    note "$dev is set read-only for the kernel (restored on exit)"
  else
    warn "cannot set $dev read-only: continuing without the kernel's protection"
  fi
}
restore_readonly() {
  [[ $RO_SET == 1 && $RO_ORIG == 0 && -b $dev ]] || return 0
  blockdev --setrw "$dev" 2>/dev/null || true
}

# Mount, location and space checks before the first read.
preflight_device() {
  local mounted need avail
  mounted="$( (findmnt -n -o TARGET -S "$dev" || true; lsblk -nr -o MOUNTPOINTS "$dev" 2>/dev/null || true) | awk 'NF' | sort -u | paste -sd ' ')" || mounted=""
  [[ -z $mounted ]] || die "$dev is mounted ($mounted): the source must not be mounted while rescuing"
  check_destination "$dir"
  [[ -z $extract_to ]] || check_destination "$extract_to"
  # Only ddrescue itself (-x), not any command that mentions the path of the map.
  if pgrep -a -x ddrescue | grep -F -- " $map" >/dev/null; then
    die "ddrescue is already running with the map $map: stop it (Ctrl+C) and run the command again"
  fi
  # st_blocks counts 512-byte units whatever the file system.
  need=$((PART_SIZE - $(stat -c %b "$img" 2>/dev/null || echo 0) * 512))
  avail=$(($(stat -f -c '%a * %S' "$dir")))
  ((avail > need)) || die "not enough space in $dir for the image: $((need / 1000000000)) GB more are needed"
  if [[ -n $start_at ]]; then
    ((start_at < PART_SIZE)) || die "--start-at: the position is past the end of the device ($(gb "$PART_SIZE"))"
  fi
}

main() {
  ORIG_ARGS=("$@")
  parse_args "$@"
  if [[ -t 1 ]]; then
    C_RED=$'\e[31m' C_YELLOW=$'\e[33m' C_BOLD=$'\e[1m' C_RESET=$'\e[0m'
  fi
  validate_args
  trap 'on_err $? "$BASH_COMMAND" "$LINENO"' ERR
  if ((print_service)); then
    service_unit
    return 0
  fi
  if ((triage)); then
    TMPD="$(mktemp -d -t "$PROG.XXXXXX")"
    trap cleanup EXIT
    triage_run
    return $?
  fi

  local cmd z t p cur_timeout
  for cmd in ddrescue ddrescuelog numfmt flock lsblk blockdev; do
    command -v "$cmd" >/dev/null || die "missing command: $cmd (apt install gddrescue util-linux coreutils)"
  done
  if (($(ddrescue --version | awk 'NR == 1 {split($NF, v, "."); print v[1] * 1000 + v[2]}') < 1027)); then
    warn "GNU ddrescue older than 1.27 is untested"
  fi
  if ((!no_fs && (extract || inventory || pick || ${#file_patterns[@]}))) && ! tsk_available; then
    die "the file level needs The Sleuth Kit (fls, istat, icat, fsstat, ils, mmls): apt install sleuthkit"
  fi
  ((inventory || status)) || [[ -n $source_arg ]] || die "no source: give a device (see --help)"
  ((inventory || status)) || ((EUID == 0)) || die "root is needed to read the device: run through sudo"
  ((!extract)) || [[ -d $extract_to ]] || die "--extract-to: no such directory: $extract_to"
  [[ -d $dir ]] || die "no such directory: $dir (--dir)"
  dir="$(cd "$dir" && pwd -P)"
  if [[ -z $name ]]; then
    if [[ -n $source_arg ]]; then
      case $source_arg in
        /dev/disk/* | /dev/mapper/*) ;;
        *)
          ((inventory || status)) || die "--name is required unless SOURCE is a stable path such as /dev/disk/by-id/...: the name of $source_arg can change when the disk comes back, and the image would not match the next run"
          ;;
      esac
      name="$(basename "$source_arg")"
    elif ((inventory || status)); then
      local -a maps_found=()
      mapfile -t maps_found < <(find "$dir" -maxdepth 1 -name '*.map' ! -name '*.before-revert' -printf '%f\n' | sort)
      ((${#maps_found[@]} == 1)) || die "say which image with --name NAME (found ${#maps_found[@]} maps in $dir)"
      name="${maps_found[0]%.map}"
    else
      die "no source: give a device (see --help)"
    fi
  fi
  [[ $name != */* ]] || die "--name must not contain a slash"
  img="$dir/$name.img"
  map="$dir/$name.map"
  logs="$dir/$name.logs"
  zones="$logs/zones"
  domain="$logs/domain.map"
  LOG="$logs/rescue.log"
  MANIFEST="$logs/manifest.sha256"
  TMPD="$(mktemp -d -t "$PROG.XXXXXX")"
  STREAM_SHA="$TMPD/stream.sha"
  trap cleanup EXIT

  if ((status)); then
    status_run
    return 0
  fi
  if ((inventory)); then
    # Without the disk: the size of the partition is the end of the map.
    [[ -f $map && -f $img ]] || die "no image or map in $dir for \"$name\""
    PART_SIZE="$(map_size "$map")"
    validate_image_map
    if [[ -f $logs/sector-size && "$(cat "$logs/sector-size")" =~ ^[0-9]+$ ]]; then SECTOR="$(cat "$logs/sector-size")"; fi
    if ((DRY_RUN)); then
      info "inventory of $img: $(status_short); dry-run: nothing is run"
      return 0
    fi
    install -d -m 755 "$logs"
    exec 8>"$dir/.$name.lock"
    flock -n 8 || die "another run is in progress for \"$name\": stop it and run --inventory again"
    validate_image_map
    note "inventory by the image without the disk: $(status_short)"
    if ((extract)); then setup_owner; fi
    inventory_run
    return 0
  fi

  [[ $source_arg == /dev/disk/* ]] || warn "$source_arg may change its name when a dropped disk comes back; /dev/disk/by-id/... is safer"
  # The disk is missing — maybe the kernel dropped it in the previous run: rescan the remembered host.
  if [[ ! -b $source_arg ]] && ((rescan)) && [[ -f $logs/scsi-host ]]; then
    info "the disk is missing — rescanning $(cat "$logs/scsi-host")"
    rescan_host "$(cat "$logs/scsi-host")" || true
  fi
  [[ -b $source_arg ]] || die "no block device $source_arg: is the disk connected? What is rescued can be examined without it: $PROG --inventory --name $name --dir $dir"
  resolve_device
  PART_SIZE="$(blockdev --getsize64 "$dev")"
  if [[ -f $map ]]; then
    [[ "$(map_size "$map")" == "$PART_SIZE" ]] ||
      die "the map $map covers $(map_size "$map") bytes but $dev has $PART_SIZE: another disk? (--name picks another image)"
  fi
  validate_image_map
  identity_prepare
  preflight_device
  for z in "${add_zones[@]}"; do
    (($(parse_size "${z%%-*}") < PART_SIZE)) || die "--add-zone $z starts past the end of the device ($(gb "$PART_SIZE"))"
  done
  if ((extract)); then setup_owner; fi
  detect_temperature_source

  info "source $source_arg → $dev (disk $whole, ${TRANSPORT:-no transport}, sector $SECTOR), $PART_SIZE bytes"
  info "image $img, map $map, logs $logs"
  info "$(status_short)"
  if ((DRY_RUN)); then
    ((!$(artifact_bytes))) || info "on start the traces of a dropped disk will be returned to \"not tried\": $(gb "$(artifact_bytes)")"
    ! zones_exist || info "deferred zones: $(zones_text)$(zones_abandoned && printf ' (given up)')"
    ((${#add_zones[@]} == 0)) || info "zones to be deferred by hand: ${add_zones[*]}"
    if [[ -n "$(rescan_unavailable_reason)" ]]; then
      info "automatic return of a dropped disk: not available ($(rescan_unavailable_reason))"
    fi
    info "dry-run: nothing is run (stop at $stop °C, continue at $resume °C)"
    return 0
  fi

  install -d -m 755 "$logs"
  exec 8>"$dir/.$name.lock"
  flock -n 8 || die "another run is in progress for \"$name\""

  validate_image_map
  identity_prepare
  cp "$TMPD/source.identity" "$logs/source.identity.new"
  mv "$logs/source.identity.new" "$logs/source.identity"

  [[ -z $SCSI_HOST ]] || echo "$SCSI_HOST" >"$logs/scsi-host"
  echo "$SECTOR" >"$logs/sector-size"
  if ((kernel_timeout > 0)); then
    if [[ -w $timeout_file ]]; then
      # only raised: a kernel that already waits longer keeps its own value
      cur_timeout="$(cat "$timeout_file")"
      if [[ $cur_timeout =~ ^[0-9]+$ ]] && ((cur_timeout < kernel_timeout)); then
        orig_timeout=$cur_timeout
        echo "$kernel_timeout" >"$timeout_file"
      fi
    else
      warn "cannot change the kernel command timeout of $whole ($timeout_file is not writable here)"
    fi
  fi
  # While running, the machine neither sleeps nor reacts to a closed lid.
  if command -v systemd-inhibit >/dev/null; then
    systemd-inhibit --what=sleep:idle:handle-lid-switch --who="$PROG" --why="rescuing $name" sleep infinity 8>&- &
    INHIBIT_PID=$!
  fi
  trap 'note "interrupted — run the command again, it continues where it stopped"; write_state stopped; notify interrupted "interrupted"; exit 130' INT TERM

  RUN_STARTED=1
  set_readonly
  write_state starting
  note "start: stop at $stop °C, continue at $resume °C, check every ${interval}s; kernel command timeout $([[ -n $orig_timeout ]] && echo "$kernel_timeout s (was $orig_timeout s)" || echo unchanged)"
  notify started "rescue of $name started: $(status_short)"
  # Once: the same zone is not added again, otherwise an already narrowed zone would widen back.
  for z in "${add_zones[@]}"; do
    if grep -Fx -- "$z" "$logs/zones.added" >/dev/null 2>&1; then
      note "zone $z was added before — skipping"
      continue
    fi
    zone_put "$(parse_size "${z%%-*}")" "$(parse_size "${z#*-}")"
    printf '%s\n' "$z" >>"$logs/zones.added"
    note "zone $z deferred by hand: $(zones_text)"
  done
  if ((give_up)) && zones_exist; then
    touch "$logs/zones.abandoned"
    note "deferred zones given up: $(zones_text)"
  fi
  if (($(artifact_bytes) > artifact_limit)); then
    note "the map has $(gb "$(artifact_bytes)") of unfinished areas — traces of a dropped disk, not bad spots"
    revert_artifacts
  fi
  if ((pick)) || ((${#file_patterns[@]})); then
    targeted_run
    note "targeted recovery finished: $(status_short). Continue the normal run with the same command without --pick/--file"
    return 0
  fi
  local phase rc before fails=0 stalls=0 last_phase="" file_level_pending=0
  while phase="$(next_phase)" && [[ $phase != "done" ]]; do
    case $phase in
      meta)
        device_ok || recover_device || die_device
        meta_run
        ;;
      garbage)
        garbage_run
        ;;
      copy | scrape | retry | zones)
        device_ok || recover_device || die_device
        t="$(temperature)" || t=""
        if [[ -n $t ]] && ((t >= stop)); then wait_cool; fi
        before="$(status_short)"
        rc=0
        run_ddrescue "$phase" || rc=$?
        if ((rc == 11)) || ! device_ok; then
          notify dropped "the disk dropped"
          revert_artifacts
          p="$(hang_position "$RATES")"
          [[ -z $p ]] || zone_hang "$((p))" "$phase"
          [[ "$(status_short)" == "$before" ]] || recoveries=0
          recover_device || die_device
          continue
        fi
        [[ "$(status_short)" == "$before" ]] || recoveries=0
        # Safety stop: the phase ends again and again, but the map does not change.
        if ((rc == 0)) && [[ "$(status_short)" == "$before" && $phase == "${last_phase:-}" ]]; then
          stalls=$((stalls + 1))
          ((stalls < 3)) || die "phase $phase ended three times in a row without progress — something is wrong; logs: $logs"
        else
          stalls=0
        fi
        last_phase=$phase
        case $rc in
          0)
            note "phase $phase finished: $(status_short)"
            notify phase-done "phase $phase finished: $(status_short)"
            [[ $phase != retry ]] || touch "$logs/retry.done"
            if [[ $phase == zones ]]; then
              # The zone is read: from now on it is an ordinary part of the disk, its bad spots go
              # through scrape and retry.
              awk -v s="$ZS" -v e="$ZE" '!($1 == s && $2 == e)' "$zones" >"$zones.new"
              mv "$zones.new" "$zones"
              [[ -s $zones ]] || rm -f "$zones"
              rm -f "$logs/retry.done"
            fi
            fails=0
            ;;
          10) wait_cool ;;
          *)
            if [[ "$(status_short)" == "$before" ]]; then fails=$((fails + 1)); else fails=0; fi
            ((fails < 5)) || die "ddrescue failed five times in a row without progress (code $rc); logs: $logs"
            warn "ddrescue exited with code $rc, the disk answers — continuing"
            ;;
        esac
        ;;
      zones-stuck)
        warn "deferred zones remain that the disk does not read from either side: $(zones_text)"
        warn "give them up (files inside will be reported as damaged): run the same command with --give-up-zones added"
        write_state zones-stuck
        notify zones-stuck "deferred zones remain that the disk does not read: $(zones_text)"
        exit 2
        ;;
      report)
        report
        if [[ $FS_STATE == missing ]]; then
          # Fixable: do not record the report as done, and do not loop on it.
          file_level_pending=1
          break
        fi
        touch "$logs/report.done"
        # No file level for this image: there is nothing to extract either.
        [[ $FS_STATE == ok ]] || touch "$logs/extract.done"
        ;;
      extract)
        extract
        touch "$logs/extract.done"
        ;;
    esac
  done
  if ((file_level_pending)); then
    note "imaging finished: $(status_short). The file level was not done: install the Sleuth Kit and run the same command again"
    write_state "done"
    notify "done" "imaging finished; the file level is pending (install the Sleuth Kit)"
    return 0
  fi
  note "done: $(status_short)"
  write_state "done"
  notify "done" "done: $(status_short)"
  if ((!extract)) && [[ -z $extract_to ]]; then
    info "to extract files from the image: $PROG --inventory --name $name --dir $dir --extract --extract-to DIR"
  fi
}

# Run only when executed, not when sourced (the unit tests source this file).
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
